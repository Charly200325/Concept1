                  <path d="M472.576 11.264C222.549333 11.264 19.285333 214.698667 19.285333 464.554667s203.434667 453.290667 453.290667 453.290666c86.869333 0 171.349333-24.746667 244.224-71.338666c11.946667-7.68 15.36-23.381333 7.68-35.328s-23.381333-15.36-35.328-7.68a400.469333 400.469333 0 0 1-216.576 63.317333c-221.696 0-402.090667-180.394667-402.090667-402.090667S250.88 62.464 472.576 62.464s402.090667 180.394667 402.090667 402.090667c0 110.933333-44.202667 214.186667-124.416 290.986666a25.6 25.6 0 0 0 35.328 37.034667c90.453333-86.357333 140.288-202.922667 140.288-328.021333C926.037333 214.528 722.602667 11.264 472.576 11.264zM997.205333 969.045333l-140.970666-140.970666a25.429333 25.429333 0 0 0-36.181334 0 25.429333 25.429333 0 0 0 0 36.181333l140.970667 140.970667c4.949333 4.949333 11.605333 7.509333 18.090667 7.509333s13.141333-2.56 18.090666-7.509333c10.069333-9.898667 10.069333-26.112 0-36.181334z"></path>
                  <path d="M804.352 490.154667c14.165333 0 25.6-11.434667 25.6-25.6 0-196.949333-160.256-357.205333-357.205333-357.205334-14.165333 0-25.6 11.434667-25.6 25.6s11.434667 25.6 25.6 25.6c168.789333 0 306.005333 137.216 306.005333 306.005334 0 14.165333 11.434667 25.6 25.6 25.6z"></path>
