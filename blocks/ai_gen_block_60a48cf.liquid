</header-component-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.typingElement = null;
        this.typingTexts = [];
        this.currentTextIndex = 0;
        this.currentCharIndex = 0;
        this.isDeleting = false;
        this.typingSpeed = 100;
        this.deletingSpeed = 50;
        this.pauseDuration = 2000;
      }

      connectedCallback() {
        this.menuToggle = this.querySelector('[data-menu-toggle]');
this.drawerClose = this.querySelector('[data-drawer-close]');
this.drawer = this.querySelector('[data-mobile-drawer]');
this.overlay = this.querySelector('[data-drawer-overlay]');
this.isTransparent = this.dataset.transparent === 'true';

this.searchWrapper = this.querySelector('[data-search-wrapper]');
this.searchToggle = this.querySelector('[data-search-toggle]');
this.searchInput = this.querySelector('[data-search-input]');
this.searchForm = this.querySelector('[data-search-form]');

this.typingElement = this.querySelector('[data-typing-text]');

try {
  const parsedTexts = JSON.parse({{ block.settings.typing_texts | json }});
  this.typingTexts = Array.isArray(parsedTexts) ? parsedTexts : ["explorer la collection", "porte bébé"];
} catch (e) {
  this.typingTexts = ["explorer la collection", "porte bébé"];
}

this.typingSpeed = {{ block.settings.typing_speed }};
this.deletingSpeed = {{ block.settings.deleting_speed }};
this.pauseDuration = {{ block.settings.pause_duration }};

        this.setupEventListeners();

        if (this.typingElement && this.typingTexts && this.typingTexts.length > 0) {
          this.typeText();
        }

        if (this.isTransparent) {
          this.handleScroll();
        }
      }

      setupEventListeners() {
        if (this.menuToggle) {
          this.menuToggle.addEventListener('click', () => this.openDrawer());
        }

        if (this.drawerClose) {
          this.drawerClose.addEventListener('click', () => this.closeDrawer());
        }

        if (this.overlay) {
          this.overlay.addEventListener('click', () => this.closeDrawer());
        }

        if (this.searchToggle && this.searchWrapper) {
          this.searchToggle.addEventListener('click', () => this.openSearch());
        }

        document.addEventListener('click', (e) => {
          if (this.searchWrapper && !this.searchWrapper.contains(e.target)) {
            this.closeSearch();
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.drawer && this.drawer.classList.contains('active')) {
            this.closeDrawer();
          }

          if (e.key === 'Escape') {
            this.closeSearch();
          }
        });

        if (this.isTransparent) {
          window.addEventListener('scroll', () => this.handleScroll());
        }
      }

      handleScroll() {
        if (window.scrollY > 50) {
          this.classList.remove('transparent');
        } else {
          this.classList.add('transparent');
        }
      }

      openDrawer() {
        if (this.drawer) this.drawer.classList.add('active');
        if (this.overlay) this.overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeDrawer() {
        if (this.drawer) this.drawer.classList.remove('active');
        if (this.overlay) this.overlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      openSearch() {
        if (!this.searchWrapper) return;
        this.searchWrapper.classList.add('active');

        setTimeout(() => {
          if (this.searchInput) this.searchInput.focus();
        }, 150);
      }

      closeSearch() {
        if (!this.searchWrapper) return;

        if (this.searchInput && this.searchInput.value.trim() !== '') return;

        this.searchWrapper.classList.remove('active');
      }

      typeText() {
        if (!this.typingElement || !this.typingTexts.length) return;

        const currentText = this.typingTexts[this.currentTextIndex];

        if (this.isDeleting) {
          this.typingElement.textContent = currentText.substring(0, this.currentCharIndex - 1);
          this.currentCharIndex--;
        } else {
          this.typingElement.textContent = currentText.substring(0, this.currentCharIndex + 1);
          this.currentCharIndex++;
        }

        let timeout = this.isDeleting ? this.deletingSpeed : this.typingSpeed;

        if (!this.isDeleting && this.currentCharIndex === currentText.length) {
          timeout = this.pauseDuration;
          this.isDeleting = true;
        } else if (this.isDeleting && this.currentCharIndex === 0) {
          this.isDeleting = false;
          this.currentTextIndex = (this.currentTextIndex + 1) % this.typingTexts.length;
          timeout = 500;
        }

        setTimeout(() => this.typeText(), timeout);
      }
    }

    customElements.define('header-component-{{ ai_gen_id }}', HeaderComponent{{ ai_gen_id }});
  })();
</script>

