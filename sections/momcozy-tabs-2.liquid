{% assign section_id = 'momcozy-tabs-2-' | append: section.id %}

<section
  id="{{ section_id }}"
  class="mc-tabs section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"
>
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %}">
    {% if section.settings.heading != blank or section.settings.subheading != blank or section.settings.description != blank %}
      <div class="mc-tabs__header {{ section.settings.heading_alignment }}">
        {% if section.settings.subheading != blank %}
          <p class="mc-tabs__subheading">{{ section.settings.subheading }}</p>
        {% endif %}

        {% capture heading_classes %}mc-tabs__title {{ section.settings.heading_size }}{% endcapture %}
        {% case section.settings.heading_tag %}
          {% when 'h1' %}
            <h1 class="{{ heading_classes }}">{{ section.settings.heading }}</h1>
          {% when 'h2' %}
            <h2 class="{{ heading_classes }}">{{ section.settings.heading }}</h2>
          {% when 'h3' %}
            <h3 class="{{ heading_classes }}">{{ section.settings.heading }}</h3>
          {% when 'h4' %}
            <h4 class="{{ heading_classes }}">{{ section.settings.heading }}</h4>
          {% when 'h5' %}
            <h5 class="{{ heading_classes }}">{{ section.settings.heading }}</h5>
          {% when 'h6' %}
            <h6 class="{{ heading_classes }}">{{ section.settings.heading }}</h6>
          {% when 'div' %}
            <div class="{{ heading_classes }}">{{ section.settings.heading }}</div>
          {% when 'span' %}
            <span class="{{ heading_classes }}">{{ section.settings.heading }}</span>
          {% else %}
            <p class="{{ heading_classes }}">{{ section.settings.heading }}</p>
        {% endcase %}

        {% if section.settings.description != blank %}
          <div class="mc-tabs__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="mc-tabs__toolbar">
  <div class="mc-tabs__toolbar-main">
    <div class="mc-tabs__nav-wrap">
      {% if section.settings.show_arrows_desktop %}
        <div class="mc-tabs__arrows mc-tabs__arrows--tabs">
          <button type="button" class="mc-tabs__tabs-arrow mc-tabs__tabs-arrow--prev" aria-label="Précédent">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>
        </div>
      {% endif %}

      <div class="mc-tabs__nav-outer">
        <div class="mc-tabs__nav" role="tablist">
          {% for block in section.blocks %}
            <button
              type="button"
              class="mc-tabs__tab{% if forloop.first %} is-active{% endif %}"
              data-tab-target="mc-tab-{{ block.id }}"
              data-view-all-text="{{ block.settings.view_all_text | escape }}"
              data-view-all-link="{{ block.settings.view_all_link | default: '#' }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ block.settings.tab_title }}
            </button>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.show_arrows_desktop %}
        <div class="mc-tabs__arrows mc-tabs__arrows--tabs">
          <button type="button" class="mc-tabs__tabs-arrow mc-tabs__tabs-arrow--next" aria-label="Suivant">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    {% if section.settings.show_view_all %}
      {% assign first_block = section.blocks.first %}
      <a
        class="mc-tabs__view-all mc-tabs__view-all--desktop"
        id="mc-tabs-view-all-{{ section.id }}"
        href="{{ first_block.settings.view_all_link | default: '#' }}"
      >
        <span class="mc-tabs__view-all-text">{{ first_block.settings.view_all_text }}</span>
        <span class="mc-tabs__view-all-icon" aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  {% if section.settings.show_view_all %}
    {% assign first_block = section.blocks.first %}
    <div class="mc-tabs__view-all-mobile-wrap">
      <a
        class="mc-tabs__view-all mc-tabs__view-all--mobile"
        id="mc-tabs-view-all-mobile-{{ section.id }}"
        href="{{ first_block.settings.view_all_link | default: '#' }}"
      >
        <span class="mc-tabs__view-all-text">{{ first_block.settings.view_all_text }}</span>
        <span class="mc-tabs__view-all-icon" aria-hidden="true">→</span>
      </a>
    </div>
  {% endif %}

  {% if section.settings.show_arrows_desktop %}
    <div class="mc-tabs__product-arrows">
      {% for block in section.blocks %}
        <div
          class="mc-tabs__arrows-group"
          data-arrows-for="mc-tab-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <button
            type="button"
            class="mc-tabs__arrow"
            data-slider-prev="mc-tab-{{ block.id }}"
            aria-label="Précédent"
          >
            ←
          </button>
          <button
            type="button"
            class="mc-tabs__arrow"
            data-slider-next="mc-tab-{{ block.id }}"
            aria-label="Suivant"
          >
            →
          </button>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

      <div class="mc-tabs__panels">
        {% for block in section.blocks %}
          <div
            id="mc-tab-{{ block.id }}"
            class="mc-tabs__panel{% if forloop.first %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="mc-tabs__topbar">
              {% if section.settings.show_view_all and block.settings.view_all_text != blank %}
                <a class="mc-tabs__view-all" href="{{ block.settings.view_all_link | default: '#' }}">
                  {{ block.settings.view_all_text }}
                  <span aria-hidden="true">→</span>
                </a>
              {% endif %}
            </div>

            {% assign desktop_cols = block.settings.desktop_columns | default: '3' %}
            {% assign mobile_cols = block.settings.mobile_columns | default: '1' %}
            {% assign enable_desktop_slider = block.settings.enable_desktop_slider %}
            {% assign enable_mobile_slider = block.settings.enable_mobile_slider %}
            {% assign product_limit = section.settings.product_limit | default: 6 %}

            <div
              class="mc-tabs__products-wrap{% if enable_desktop_slider and section.settings.carousel_on_desktop %} is-desktop-slider{% endif %}{% if enable_mobile_slider and section.settings.swipe_on_mobile %} is-mobile-slider{% endif %}"
              data-products-slider="mc-tab-{{ block.id }}"
            >
              <div class="mc-tabs__products grid-d-{{ desktop_cols }} grid-m-{{ mobile_cols }}">
                {% assign rendered_products = 0 %}

                {% for i in (1..product_limit) %}
                  {% liquid
                    assign product_key = 'product_' | append: i
                    assign title_key = 'custom_title_' | append: i
                    assign show_badge_key = 'show_badge_' | append: i
                    assign badge_text_key = 'badge_text_' | append: i
                    assign benefit_1_key = 'benefit_1_' | append: i
                    assign benefit_2_key = 'benefit_2_' | append: i
                    assign benefit_3_key = 'benefit_3_' | append: i
                    assign benefit_4_key = 'benefit_4_' | append: i
                    assign rating_key = 'rating_' | append: i
                    assign reviews_count_key = 'reviews_count_' | append: i

                    assign product = block.settings[product_key]
                    assign custom_title = block.settings[title_key]
                    assign show_badge = block.settings[show_badge_key]
                    assign custom_badge_text = block.settings[badge_text_key]
                    assign benefit_1 = block.settings[benefit_1_key]
                    assign benefit_2 = block.settings[benefit_2_key]
                    assign benefit_3 = block.settings[benefit_3_key]
                    assign benefit_4 = block.settings[benefit_4_key]
                    assign custom_rating = block.settings[rating_key] | default: 5
                    assign custom_reviews_count = block.settings[reviews_count_key]
                  %}

                  {% if product != blank %}
                    {% assign rendered_products = rendered_products | plus: 1 %}
                    {% assign hover_image = blank %}
                    {% if product.images.size > 1 %}
                      {% assign hover_image = product.images[1] %}
                    {% endif %}

                    {% assign quick_add_variant = product.selected_or_first_available_variant %}

                    <div class="mc-card">
                      <div class="mc-card__inner">
                        <div class="mc-card__content">
                          <div class="mc-card__header">
                            <h3 class="mc-card__title">
                              <a href="{{ product.url }}">
                                {% if custom_title != blank %}
                                  {{ custom_title }}
                                {% else %}
                                  {{ product.title }}
                                {% endif %}
                              </a>
                            </h3>

                            {% if block.settings.show_rating %}
                              {% liquid
                                assign rating_percentage = custom_rating | times: 20
                              %}
                              <div class="mc-card__rating">
                                <div
                                  class="mc-card__stars"
                                  aria-label="Note de {{ custom_rating }} sur 5"
                                  style="--rating-percent: {{ rating_percentage }}%;"
                                >
                                  <span class="mc-card__stars-bg">★★★★★</span>
                                  <span class="mc-card__stars-fill">★★★★★</span>
                                </div>

                                {% if custom_reviews_count != blank %}
                                  <div class="mc-card__reviews">({{ custom_reviews_count }})</div>
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>

                          <div class="mc-card__image-wrap">
                            <a class="mc-card__image-link" href="{{ product.url }}">
                              {% if product.featured_image != blank %}
                                {{
                                  product.featured_image
                                  | image_url: width: 1200
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '360,535,720,900,1200',
                                    class: 'mc-card__image mc-card__image--main',
                                    alt: product.title | escape
                                }}
                              {% endif %}

                              {% if hover_image != blank %}
                                {{
                                  hover_image
                                  | image_url: width: 1200
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '360,535,720,900,1200',
                                    class: 'mc-card__image mc-card__image--hover',
                                    alt: product.title | escape
                                }}
                              {% endif %}
                            </a>

                            {% if block.settings.show_badges and show_badge and custom_badge_text != blank %}
                              <div class="mc-card__badge">{{ custom_badge_text }}</div>
                            {% endif %}
                          </div>

                          {% if block.settings.show_benefits %}
                            <div class="mc-card__benefits-wrap">
                              <div class="mc-card__divider"></div>
                              <div class="mc-card__tags">
                                {% if benefit_1 != blank %}<span>{{ benefit_1 }}</span>{% endif %}
                                {% if benefit_2 != blank %}<span>{{ benefit_2 }}</span>{% endif %}
                                {% if benefit_3 != blank %}<span>{{ benefit_3 }}</span>{% endif %}
                                {% if benefit_4 != blank %}<span>{{ benefit_4 }}</span>{% endif %}
                              </div>
                            </div>
                          {% endif %}

                          {% if block.settings.show_price %}
                            <div class="mc-card__price">
                              {% if product.compare_at_price > product.price %}
                                <span class="mc-card__price-sale">{{ product.price | money }}</span>
                                <span class="mc-card__price-compare">{{ product.compare_at_price | money }}</span>
                              {% else %}
                                <span class="mc-card__price-regular">{{ product.price | money }}</span>
                              {% endif %}
                            </div>
                          {% endif %}
                        </div>

                        <div class="mc-card__actions">
  <a class="mc-card__button" href="{{ product.url }}">
    {{ block.settings.button_text }}
  </a>

  {% if block.settings.enable_quick_add and quick_add_variant != blank and product.available %}
    {% form 'product', product, class: 'mc-card__quick-add-form mc-card__quick-add-form--icon' %}
      <input type="hidden" name="id" value="{{ quick_add_variant.id }}">
      <button
        type="submit"
        class="mc-card__quick-add-icon"
        aria-label="Ajouter {{ product.title | escape }} au panier"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M1 1h.5v0c.226 0 .339 0 .44.007a3 3 0 0 1 2.62 1.976c.034.095.065.204.127.42l.17.597m0 0 1.817 6.358c.475 1.664.713 2.496 1.198 3.114a4 4 0 0 0 1.633 1.231c.727.297 1.592.297 3.322.297h2.285c1.75 0 2.626 0 3.359-.302a4 4 0 0 0 1.64-1.253c.484-.627.715-1.472 1.175-3.161l.06-.221c.563-2.061.844-3.092.605-3.906a3 3 0 0 0-1.308-1.713C19.92 4 18.853 4 16.716 4H4.857Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 20a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 20a2 2 0 1 1-4 0 2 2 0 0 1 4 0Z"/>
        </svg>
      </button>
    {% endform %}
  {% endif %}
</div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}

                {% if rendered_products == 0 %}
                  <div class="mc-empty">
                    Sélectionne au moins un produit dans cet onglet.
                  </div>
                {% endif %}
              </div>
            </div>

            <div class="mc-tabs__banners">
              {% for i in (1..2) %}
                {% liquid
                  assign b_enable = 'banner_' | append: i | append: '_enable'
                  assign b_image = 'banner_' | append: i | append: '_image'
                  assign b_title = 'banner_' | append: i | append: '_title'
                  assign b_text = 'banner_' | append: i | append: '_text'
                  assign b_button = 'banner_' | append: i | append: '_button'
                  assign b_link = 'banner_' | append: i | append: '_link'
                %}

                {% if block.settings[b_enable] %}
                  <div class="mc-banner">
                    <div class="mc-banner__inner">
                      {% if block.settings[b_image] != blank %}
                        <a href="{{ block.settings[b_link] | default: '#' }}" class="mc-banner__image-link">
                          {{
                            block.settings[b_image]
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'lazy',
                              widths: '480,720,960,1200,1400',
                              class: 'mc-banner__image',
                              alt: block.settings[b_title] | escape
                          }}
                        </a>
                      {% endif %}

                      <div class="mc-banner__overlay">
                        {% if block.settings[b_title] != blank %}
                          <h3 class="mc-banner__title">{{ block.settings[b_title] }}</h3>
                        {% endif %}

                        {% if block.settings[b_text] != blank %}
                          <div class="mc-banner__text">{{ block.settings[b_text] }}</div>
                        {% endif %}

                        {% if block.settings[b_button] != blank %}
                          <a class="mc-banner__button" href="{{ block.settings[b_link] | default: '#' }}">
                            {{ block.settings[b_button] }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    #{{ section_id }} {
      background: {{ section.settings.bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      color: {{ section.settings.text_color }};
    }

    #{{ section_id }}.section--divider {
      border-top: 1px solid rgba(0,0,0,.08);
    }

    #{{ section_id }}.section--rounded {
      border-radius: 28px;
      overflow: hidden;
    }

    #{{ section_id }} .mc-tabs__header {
      margin-bottom: 24px;
    }

    #{{ section_id }} .mc-tabs__header.text-left {
      text-align: left;
    }

    #{{ section_id }} .mc-tabs__header.text-center {
      text-align: center;
    }

    #{{ section_id }} .mc-tabs__header.text-right {
      text-align: right;
    }

    #{{ section_id }} .mc-tabs__subheading {
      margin: 0 0 10px;
      color: {{ section.settings.muted_text }};
      font-size: 14px;
      line-height: 1.2;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    #{{ section_id }} .mc-tabs__title {
      margin: 0;
      line-height: 0.98;
      font-weight: 600;
      letter-spacing: -0.04em;
      max-width: 760px;
      white-space: pre-line;
    }

    #{{ section_id }} .mc-tabs__title.title-sm {
      font-size: clamp(28px, 4vw, 42px);
    }

    #{{ section_id }} .mc-tabs__title.title-md {
      font-size: clamp(34px, 5vw, 66px);
    }

    #{{ section_id }} .mc-tabs__title.title-lg {
      font-size: clamp(40px, 6vw, 78px);
    }

    #{{ section_id }} .mc-tabs__title.title-xl {
      font-size: clamp(46px, 7vw, 92px);
    }

    #{{ section_id }} .mc-tabs__header.text-center .mc-tabs__title {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ section_id }} .mc-tabs__header.text-right .mc-tabs__title {
      margin-left: auto;
    }

    #{{ section_id }} .mc-tabs__description {
      margin-top: 14px;
      max-width: 760px;
      color: {{ section.settings.muted_text }};
      font-size: 16px;
      line-height: 1.5;
    }

    #{{ section_id }} .mc-tabs__header.text-center .mc-tabs__description {
      margin-left: auto;
      margin-right: auto;
    }

    #{{ section_id }} .mc-tabs__header.text-right .mc-tabs__description {
      margin-left: auto;
    }

    #{{ section_id }} .mc-tabs__toolbar {
  display: flex;
  flex-direction: column;
  gap: 18px;
  margin-bottom: 28px;
}
#{{ section_id }} .mc-tabs__toolbar-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
#{{ section_id }} .mc-tabs__nav-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
  flex: 1 1 auto;
}
#{{ section_id }} .mc-tabs__nav-outer {
  min-width: 0;
  flex: 1 1 auto;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
#{{ section_id }} .mc-tabs__nav-outer::-webkit-scrollbar {
  display: none;
}

    #{{ section_id }} .mc-tabs__nav {
  display: flex !important;
  gap: 16px;
  flex-wrap: nowrap;
  width: max-content;
}
#{{ section_id }} .mc-tabs__tab {
  appearance: none;
  border: 0;
  background: {{ section.settings.tab_bg }};
  color: {{ section.settings.tab_text }};
  border-radius: 999px;
  padding: 14px 20px;
  font-size: 15px;
  line-height: 1;
  font-weight: 500;
  cursor: pointer;
  transition: .25s ease;
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  white-space: nowrap;
  flex: 0 0 auto;
}
#{{ section_id }} .mc-tabs__tab.is-active,
#{{ section_id }} .mc-tabs__tab:hover {
  background: {{ section.settings.tab_active_bg }};
  color: {{ section.settings.tab_active_text }};
}
#{{ section_id }} .mc-tabs__arrows--tabs {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}
#{{ section_id }} .mc-tabs__tabs-arrow {
  width: 52px;
  height: 52px;
  border: 0;
  background: transparent;
  color: #1b1b1b;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  padding: 0;
}

#{{ section_id }} .mc-tabs__tabs-arrow svg {
  width: 24px;
  height: 24px;
}

    #{{ section_id }} .mc-tabs__tab {
      appearance: none;
      border: 0;
      background: {{ section.settings.tab_bg }};
      color: {{ section.settings.tab_text }};
      border-radius: 999px;
      padding: 13px 18px;
      font-size: 14px;
      line-height: 1;
      font-weight: 500;
      cursor: pointer;
      transition: .25s ease;
    }

    #{{ section_id }} .mc-tabs__tab.is-active,
    #{{ section_id }} .mc-tabs__tab:hover {
      background: {{ section.settings.tab_active_bg }};
      color: {{ section.settings.tab_active_text }};
    }

    #{{ section_id }} .mc-tabs__arrows {
      display: flex;
      align-items: center;
    }
    #{{ section_id }} .mc-tabs__view-all:hover {
  opacity: .85;
}

#{{ section_id }} .mc-tabs__view-all-text {
  font-size: 16px;
  font-weight: 400;
}

#{{ section_id }} .mc-tabs__view-all-icon {
  font-size: 22px;
  line-height: 1;
  display: inline-flex;
  transform: translateY(-1px);
}

#{{ section_id }} .mc-tabs__view-all--desktop {
  flex: 0 0 auto;
}

#{{ section_id }} .mc-tabs__view-all-mobile-wrap {
  display: none;
}

#{{ section_id }} .mc-tabs__product-arrows {
  display: none;
}

    #{{ section_id }} .mc-tabs__arrows-group {
      display: flex;
      gap: 10px;
    }

    #{{ section_id }} .mc-tabs__arrow {
      appearance: none;
      border: 0;
      width: 44px;
      height: 44px;
      border-radius: 999px;
      background: {{ section.settings.tab_bg }};
      color: {{ section.settings.tab_text }};
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      transition: .25s ease;
    }

    #{{ section_id }} .mc-tabs__arrow:hover {
      background: {{ section.settings.tab_active_bg }};
      color: {{ section.settings.tab_active_text }};
    }

    #{{ section_id }} .mc-tabs__arrow[disabled] {
      opacity: .35;
      cursor: not-allowed;
    }

    #{{ section_id }} .mc-tabs__panel {
      display: none;
    }

    #{{ section_id }} .mc-tabs__panel.is-active {
      display: block;
    }

    #{{ section_id }} .mc-tabs__topbar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 18px;
    }

    #{{ section_id }} .mc-tabs__view-all {
  text-decoration: none;
  color: {{ section.settings.text_color }};
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-bottom: 2px solid currentColor;
  padding-bottom: 6px;
  line-height: 1;
  white-space: nowrap;
  transition: opacity .25s ease, transform .25s ease;
}

    #{{ section_id }} .mc-tabs__products-wrap {
      overflow: visible;
      margin-bottom: 18px;
    }

    #{{ section_id }} .mc-tabs__products {
      display: grid;
      gap: 10px;
    }

    #{{ section_id }} .mc-tabs__products.grid-d-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #{{ section_id }} .mc-tabs__products.grid-d-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #{{ section_id }} .mc-tabs__products.grid-d-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #{{ section_id }} .mc-tabs__products.grid-d-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }

    #{{ section_id }} .mc-card {
      min-width: 0;
    }

    #{{ section_id }} .mc-card__inner {
      background: {{ section.settings.card_bg }};
      border-radius: 24px;
      padding: 18px 14px 16px;
      height: 100%;
