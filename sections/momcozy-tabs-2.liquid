      docume<script>
nt.addEventListener('DOMContentLoaded', function () {
      var section = document.getElementById('{{ section_id }}');
      if (!section) return;

      var tabs = section.querySelectorAll('.mc-tabs__tab');
      var panels = section.querySelectorAll('.mc-tabs__panel');
      var arrowGroups = section.querySelectorAll('.mc-tabs__arrows-group');

      function updateArrowState(panelId) {
        var slider = section.querySelector('[data-products-slider="' + panelId + '"]');
        if (!slider) return;

        var prevBtn = section.querySelector('[data-slider-prev="' + panelId + '"]');
        var nextBtn = section.querySelector('[data-slider-next="' + panelId + '"]');
        if (!prevBtn || !nextBtn) return;

        var maxScroll = slider.scrollWidth - slider.clientWidth;
        var currentScroll = slider.scrollLeft;

        prevBtn.disabled = currentScroll <= 5;
        nextBtn.disabled = currentScroll >= maxScroll - 5 || maxScroll <= 5;
      }

      function activateTab(target) {
        tabs.forEach(function(tab) {
          var isActive = tab.getAttribute('data-tab-target') === target;
          tab.classList.toggle('is-active', isActive);
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });

        panels.forEach(function(panel) {
          panel.classList.toggle('is-active', panel.id === target);
        });

        arrowGroups.forEach(function(group) {
          if (group.getAttribute('data-arrows-for') === target) {
            group.removeAttribute('hidden');
          } else {
            group.setAttribute('hidden', '');
          }
        });

        setTimeout(function() {
          updateArrowState(target);
        }, 80);
      }

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          activateTab(this.getAttribute('data-tab-target'));
        });
      });

      section.querySelectorAll('[data-slider-prev]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var target = this.getAttribute('data-slider-prev');
          var slider = section.querySelector('[data-products-slider="' + target + '"]');
          if (!slider) return;

          slider.scrollBy({
            left: -Math.min(slider.clientWidth * 0.85, 420),
            behavior: 'smooth'
          });

          setTimeout(function() {
            updateArrowState(target);
          }, 350);
        });
      });

      section.querySelectorAll('[data-slider-next]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var target = this.getAttribute('data-slider-next');
          var slider = section.querySelector('[data-products-slider="' + target + '"]');
          if (!slider) return;

          slider.scrollBy({
            left: Math.min(slider.clientWidth * 0.85, 420),
            behavior: 'smooth'
          });

          setTimeout(function() {
            updateArrowState(target);
          }, 350);
        });
      });

      section.querySelectorAll('[data-products-slider]').forEach(function(slider) {
        slider.addEventListener('scroll', function() {
          var panel = slider.getAttribute('data-products-slider');
          updateArrowState(panel);
        });
      });

      window.addEventListener('resize', function() {
        var activePanel = section.querySelector('.mc-tabs__panel.is-active');
        if (activePanel) {
          updateArrowState(activePanel.id);
        }
      });

      var firstPanel = section.querySelector('.mc-tabs__panel.is-active');
      if (firstPanel) {
        activateTab(firstPanel.id);
      }
    });
  </script>
</section>

