    display: none;
  }

  .mc-mobile-drawer__item.is-open .mc-mobile-drawer__submenu {
    display: block;
  }

  .mc-mobile-drawer__sublink {
    display: block;
    padding: 10px 0 10px 14px;
    color: #555;
    font-size: 14px;
    font-weight: 500;
  }

  .mc-mobile-drawer__footer {
    margin-top: auto;
    padding-top: 18px;
  }

  .mc-mobile-drawer__cart-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 48px;
    padding: 0 16px;
    border-radius: 14px;
    background: var(--mc-accent);
