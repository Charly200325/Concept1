{% comment %}
  Section: Momcozy-style Header
  File suggestion: sections/momcozy-header.liquid
{% endcomment %}

{{ 'section-momcozy-header.css' | asset_url | stylesheet_tag }}

{% liquid
  assign menu_top = section.settings.top_menu
  assign menu_main = section.settings.main_menu
  assign logo = section.settings.logo
%}

<header class="mc-header" data-sticky-header>
  <div class="mc-header__topbar">
    <div class="page-width mc-header__topbar-inner">
      <nav class="mc-header__topnav" aria-label="Top navigation">
        <ul class="mc-header__toplist" role="list">
          {% for link in linklists[menu_top].links %}
            <li>
              <a href="{{ link.url }}" class="mc-header__toplink{% if link.current %} is-active{% endif %}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="mc-header__utilities">
        {% if localization.available_countries.size > 1 %}
          <localization-form>
            {% form 'localization', id: 'HeaderCountryForm', class: 'mc-loc-form' %}
              <div class="mc-select-wrap">
                <select name="country_code" aria-label="{{ 'localization.country_label' | t }}" onchange="this.form.submit()">
                  {% for country in localization.available_countries %}
                    <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                      {{ country.currency.iso_code }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endform %}
          </localization-form>
        {% endif %}

        {% if localization.available_languages.size > 1 %}
          <localization-form>
            {% form 'localization', id: 'HeaderLanguageForm', class: 'mc-loc-form' %}
              <div class="mc-select-wrap">
                <select name="locale_code" aria-label="{{ 'localization.language_label' | t }}" onchange="this.form.submit()">
                  {% for language in localization.available_languages %}
                    <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endform %}
          </localization-form>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="mc-header__main">
    <div class="page-width mc-header__main-inner">
      <button class="mc-header__drawer-btn" type="button" aria-label="Open menu" data-mobile-menu-toggle>
        <span></span><span></span><span></span>
      </button>

      <a href="{{ routes.root_url }}" class="mc-header__logo" aria-label="{{ shop.name }}">
        {% if logo != blank %}
          {{ logo | image_url: width: 320 | image_tag: class: 'mc-header__logo-image', loading: 'eager', widths: '160,240,320', alt: shop.name }}
        {% else %}
          <span class="mc-header__logo-text">{{ shop.name }}</span>
        {% endif %}
      </a>

      <nav class="mc-header__nav" aria-label="Main navigation">
        <ul class="mc-header__nav-list" role="list">
          {% for link in linklists[menu_main].links %}
            <li class="mc-header__nav-item{% if link.links != blank %} has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="mc-header__nav-link{% if link.current %} is-active{% endif %}">
                <span>{{ link.title }}</span>
                {% if link.links != blank %}
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endif %}
              </a>

              {% if link.links != blank %}
                <div class="mc-mega-menu">
                  <div class="mc-mega-menu__inner page-width">
                    <div class="mc-mega-menu__content">
                      <div class="mc-mega-menu__quicklinks">
                        <p class="mc-mega-menu__label">Quick links:</p>
                        <div class="mc-mega-menu__chips">
                          {% for child_link in link.links limit: 8 %}
                            <a href="{{ child_link.url }}" class="mc-chip">{{ child_link.title }}</a>
                          {% endfor %}
                        </div>
                      </div>

                      <div class="mc-mega-menu__grid">
                        <div class="mc-mega-menu__products">
                          <div class="mc-mega-menu__section-head">
                            <h3>{{ link.title }}</h3>
                            {% if section.settings.quiz_label != blank and section.settings.quiz_link != blank %}
                              <a href="{{ section.settings.quiz_link }}" class="mc-outline-btn">{{ section.settings.quiz_label }}</a>
                            {% endif %}
                          </div>

                          {% if section.settings.section_description != blank %}
                            <p class="mc-mega-menu__desc">{{ section.settings.section_description }}</p>
                          {% endif %}

                          <div class="mc-product-cards">
                            {% for block in section.blocks %}
                              {% if block.type == 'product_card' %}
                                <a href="{{ block.settings.link }}" class="mc-product-card" {{ block.shopify_attributes }}>
                                  <div class="mc-product-card__image">
                                    {% if block.settings.image != blank %}
                                      {{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.heading }}
                                    {% endif %}
                                  </div>
                                  <div class="mc-product-card__content">
                                    <h4>{{ block.settings.heading }}</h4>
                                    <p>{{ block.settings.subheading }}</p>
                                  </div>
                                </a>
                              {% endif %}
                            {% endfor %}
                          </div>

                          {% if section.settings.shop_all_label != blank and section.settings.shop_all_link != blank %}
                            <a href="{{ section.settings.shop_all_link }}" class="mc-shop-all">{{ section.settings.shop_all_label }}</a>
                          {% endif %}
                        </div>

                        <aside class="mc-mega-menu__sidebar">
                          {% if section.settings.sidebar_heading != blank %}
                            <h3 class="mc-sidebar-title">{{ section.settings.sidebar_heading }}</h3>
                          {% endif %}

                          <div class="mc-sidebar-card mc-sidebar-card--large">
                            {% if section.settings.sidebar_image_1 != blank %}
                              {{ section.settings.sidebar_image_1 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320,480,700', alt: section.settings.sidebar_title_1 }}
                            {% endif %}
                            <div class="mc-sidebar-card__body">
                              <h4>{{ section.settings.sidebar_title_1 }}</h4>
                              <p>{{ section.settings.sidebar_text_1 }}</p>
                            </div>
                          </div>

                          <div class="mc-sidebar-card mc-sidebar-card--small">
                            {% if section.settings.sidebar_image_2 != blank %}
                              {{ section.settings.sidebar_image_2 | image_url: width: 500 | image_tag: loading: 'lazy', widths: '240,360,500', alt: section.settings.sidebar_title_2 }}
                            {% endif %}
                            <div class="mc-sidebar-card__body">
                              <h4>{{ section.settings.sidebar_title_2 }}</h4>
                              <p>{{ section.settings.sidebar_text_2 }}</p>
                            </div>
                          </div>
                        </aside>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="mc-header__search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="mc-search-form">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder }}"
            aria-label="{{ section.settings.search_placeholder }}"
          >
          <button type="submit" aria-label="Search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m20 20-3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
          </button>
        </form>
      </div>

      <div class="mc-header__icons">
        <a href="{{ routes.account_url }}" aria-label="Account" class="mc-icon-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c1.6-4 5-6 8-6s6.4 2 8 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </a>
        <a href="/pages/wishlist" aria-label="Wishlist" class="mc-icon-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" aria-label="Cart" class="mc-icon-link mc-cart-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 7h12l-1 11H7L6 7Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 7a3 3 0 0 1 6 0" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
          <span class="mc-count">{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="mc-mobile-drawer" data-mobile-drawer>
    <div class="mc-mobile-drawer__overlay" data-mobile-menu-close></div>
    <div class="mc-mobile-drawer__panel">
      <button class="mc-mobile-drawer__close" type="button" aria-label="Close menu" data-mobile-menu-close>×</button>
      <nav aria-label="Mobile navigation">
        <ul class="mc-mobile-drawer__list" role="list">
          {% for link in linklists[menu_main].links %}
            <li>
              <a href="{{ link.url }}">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .mc-header {
    --mc-accent: {{ section.settings.accent_color }};
    --mc-text: {{ section.settings.text_color }};
    --mc-bg: {{ section.settings.background_color }};
    --mc-muted: #6d6d6d;
    --mc-border: rgba(0,0,0,.08);
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--mc-bg);
  }

  .mc-header a { text-decoration: none; }
  .mc-header .page-width { max-width: 1440px; margin: 0 auto; padding: 0 24px; }

  .mc-header__topbar {
    background: var(--mc-accent);
    color: #fff;
  }

  .mc-header__topbar-inner,
  .mc-header__main-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .mc-header__topbar-inner { min-height: 48px; }
  .mc-header__toplist,
  .mc-header__nav-list,
  .mc-mobile-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mc-header__toplist,
  .mc-header__nav-list {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .mc-header__toplink {
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    opacity: .95;
  }

  .mc-header__toplink.is-active,
  .mc-header__toplink:hover { text-decoration: underline; text-underline-offset: 6px; }

  .mc-header__utilities {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .mc-select-wrap select {
    border: 0;
    background: transparent;
    color: #fff;
    font-size: 15px;
    cursor: pointer;
  }

  .mc-header__main {
    background: var(--mc-bg);
    border-bottom: 1px solid var(--mc-border);
  }

  .mc-header__main-inner {
    min-height: 88px;
    position: relative;
  }

  .mc-header__logo { flex: 0 0 auto; }
  .mc-header__logo-image { display: block; max-width: 240px; height: auto; }
  .mc-header__logo-text { font-size: 32px; font-weight: 800; color: var(--mc-accent); }

  .mc-header__nav { flex: 1 1 auto; }

  .mc-header__nav-item { position: static; }
  .mc-header__nav-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 88px;
    color: var(--mc-text);
    font-size: 16px;
    font-weight: 700;
  }

  .mc-header__nav-link svg { width: 16px; height: 16px; }
  .mc-header__nav-link.is-active,
  .mc-header__nav-link:hover { color: var(--mc-accent); }

  .mc-header__search { flex: 0 0 340px; }
  .mc-search-form {
    display: flex;
    align-items: center;
    border: 2px solid rgba(0,0,0,.25);
    border-radius: 999px;
    overflow: hidden;
    min-height: 50px;
    background: #fff;
  }

  .mc-search-form input {
    width: 100%;
    border: 0;
    outline: 0;
    padding: 0 16px;
    font-size: 15px;
    background: transparent;
  }

  .mc-search-form button {
    width: 54px;
    height: 50px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .mc-search-form svg,
  .mc-icon-link svg { width: 24px; height: 24px; }

  .mc-header__icons {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 0 0 auto;
  }

  .mc-icon-link {
    position: relative;
    color: var(--mc-text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mc-count {
    position: absolute;
    top: -8px;
    right: -8px;
    min-width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--mc-accent);
    color: #fff;
    font-size: 11px;
    line-height: 18px;
    text-align: center;
    font-weight: 700;
    padding: 0 4px;
  }

  .mc-mega-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: #fff;
    border-top: 1px solid var(--mc-border);
    border-bottom: 1px solid var(--mc-border);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(8px);
    transition: .22s ease;
  }

  .mc-header__nav-item.has-dropdown:hover .mc-mega-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .mc-mega-menu__content { padding: 28px 0 36px; }
  .mc-mega-menu__quicklinks {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--mc-border);
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .mc-mega-menu__label {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
    color: var(--mc-text);
  }

  .mc-mega-menu__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .mc-chip {
    padding: 11px 22px;
    background: #f2f2f2;
    color: var(--mc-text);
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
  }

  .mc-mega-menu__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, .55fr);
    gap: 42px;
  }

  .mc-mega-menu__section-head {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .mc-mega-menu__section-head h3,
  .mc-sidebar-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.1;
    color: var(--mc-text);
  }

  .mc-outline-btn {
    border: 2px solid var(--mc-text);
    border-radius: 999px;
    color: var(--mc-text);
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
  }

  .mc-mega-menu__desc {
    margin: 0 0 24px;
    color: var(--mc-muted);
    max-width: 720px;
    font-size: 16px;
    line-height: 1.4;
  }

  .mc-product-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .mc-product-card {
    display: grid;
    grid-template-columns: 84px 1fr;
    gap: 16px;
    align-items: center;
    background: #f7f7f7;
    border-radius: 16px;
    padding: 18px;
    color: var(--mc-text);
    min-height: 116px;
  }

  .mc-product-card__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .mc-product-card__content h4 {
    margin: 0 0 4px;
    font-size: 18px;
    line-height: 1.2;
  }

  .mc-product-card__content p {
    margin: 0;
    color: var(--mc-muted);
    font-size: 15px;
    line-height: 1.35;
  }

  .mc-shop-all {
    display: inline-block;
    margin-top: 28px;
    color: var(--mc-accent);
    font-weight: 800;
    font-size: 18px;
    text-transform: uppercase;
    border-bottom: 3px solid var(--mc-accent);
    padding-bottom: 4px;
  }

  .mc-mega-menu__sidebar {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .mc-sidebar-card {
    background: #f7f7f7;
    border-radius: 18px;
    overflow: hidden;
  }

  .mc-sidebar-card img {
    display: block;
    width: 100%;
    height: auto;
  }

  .mc-sidebar-card__body {
    padding: 16px 18px 18px;
  }

  .mc-sidebar-card__body h4 {
    margin: 0 0 6px;
    font-size: 24px;
  }

  .mc-sidebar-card__body p {
    margin: 0;
    font-size: 15px;
    color: var(--mc-muted);
    line-height: 1.4;
  }

  .mc-header__drawer-btn,
  .mc-mobile-drawer { display: none; }

  @media screen and (max-width: 1199px) {
    .mc-header__search { flex-basis: 280px; }
    .mc-product-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mc-mega-menu__grid { grid-template-columns: 1fr; }
  }

  @media screen and (max-width: 989px) {
    .mc-header__topbar { display: none; }
    .mc-header__drawer-btn {
      display: inline-flex;
      flex-direction: column;
      gap: 4px;
      background: transparent;
      border: 0;
      padding: 0;
      width: 28px;
      cursor: pointer;
    }

    .mc-header__drawer-btn span {
      display: block;
      width: 28px;
      height: 2px;
      background: var(--mc-text);
      border-radius: 10px;
    }

    .mc-header__main-inner {
      display: grid;
      grid-template-columns: 28px 1fr auto;
      gap: 16px;
      min-height: 72px;
    }

    .mc-header__nav,
    .mc-header__search { display: none; }

    .mc-header__logo {
      justify-self: center;
    }

    .mc-header__logo-image { max-width: 190px; }
    .mc-header__icons { gap: 12px; }

    .mc-mobile-drawer {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 60;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: .2s ease;
    }

    .mc-mobile-drawer.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .mc-mobile-drawer__overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,.35);
    }

    .mc-mobile-drawer__panel {
      position: absolute;
      top: 0;
      left: 0;
      bottom: 0;
      width: min(86vw, 380px);
      background: #fff;
      padding: 24px;
      transform: translateX(-100%);
      transition: .22s ease;
      overflow: auto;
    }

    .mc-mobile-drawer.is-open .mc-mobile-drawer__panel { transform: translateX(0); }
    .mc-mobile-drawer__close {
      border: 0;
      background: transparent;
      font-size: 32px;
      line-height: 1;
      margin-bottom: 24px;
      cursor: pointer;
    }

    .mc-mobile-drawer__list { display: grid; gap: 14px; }
    .mc-mobile-drawer__list a {
      color: var(--mc-text);
      font-size: 18px;
      font-weight: 700;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const drawer = document.querySelector('[data-mobile-drawer]');
    const openBtn = document.querySelector('[data-mobile-menu-toggle]');
    const closeBtns = document.querySelectorAll('[data-mobile-menu-close]');

    if (drawer && openBtn) {
      openBtn.addEventListener('click', function () {
        drawer.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });

      closeBtns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          drawer.classList.remove('is-open');
          document.body.style.overflow = '';
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "Momcozy header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "top_menu", "label": "Top menu" },
    { "type": "link_list", "id": "main_menu", "label": "Main menu" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "I am looking for Sound Machine" },
    { "type": "text", "id": "quiz_label", "label": "Quiz button label", "default": "Quick Quiz" },
    { "type": "url", "id": "quiz_link", "label": "Quiz button link" },
    { "type": "textarea", "id": "section_description", "label": "Mega menu description", "default": "I work in Healthcare. These have been a lifesaver so far. I am also an active mother of 4, so these came in handy. They are easy to assemble and easy to clean." },
    { "type": "text", "id": "shop_all_label", "label": "Shop all label", "default": "Shop all breast pumps" },
    { "type": "url", "id": "shop_all_link", "label": "Shop all link" },
    { "type": "text", "id": "sidebar_heading", "label": "Sidebar heading", "default": "Consider these:" },
    { "type": "image_picker", "id": "sidebar_image_1", "label": "Sidebar image 1" },
    { "type": "text", "id": "sidebar_title_1", "label": "Sidebar title 1", "default": "Lifestyle feature" },
    { "type": "textarea", "id": "sidebar_text_1", "label": "Sidebar text 1", "default": "Use this space for a lifestyle banner like Momcozy." },
    { "type": "image_picker", "id": "sidebar_image_2", "label": "Sidebar image 2" },
    { "type": "text", "id": "sidebar_title_2", "label": "Sidebar title 2", "default": "Air 1" },
    { "type": "textarea", "id": "sidebar_text_2", "label": "Sidebar text 2", "default": "Ultra-slim breast pump" },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#9c5a5a" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#1f1f1f" }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Custom Pumping" },
        { "type": "text", "id": "subheading", "label": "Subheading", "default": "M9 Wearable Breast Pump" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
