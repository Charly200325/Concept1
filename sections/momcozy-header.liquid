{% comment %}
  Section: Momcozy-style Header
  Version adaptée pour Shopify section
  Note: le code que tu as fourni utilisait block.settings / block.id.
  Ici il faut l'adapter en section.settings / section.id pour que ça fonctionne dans un fichier sections/*.liquid.
{% endcomment %}

{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

<header-component-{{ ai_gen_id }} class="mc-header ai-header-{{ ai_gen_id }} {% if section.settings.enable_transparent %}transparent{% endif %}" data-transparent="{{ section.settings.enable_transparent }}">
  <div class="mc-header__topbar">
    <div class="page-width mc-header__topbar-inner ai-header-container-{{ ai_gen_id }}">
      <nav class="mc-header__topnav" aria-label="Top navigation">
        <ul class="mc-header__toplist" role="list">
          {% for link in linklists[section.settings.top_menu].links %}
            <li><a href="{{ link.url }}" class="mc-header__toplink{% if link.current %} is-active{% endif %}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <div class="mc-header__utilities ai-header-actions-{{ ai_gen_id }}">
        {% if section.settings.enable_country_selector and localization.available_countries.size > 1 %}
          <localization-form>
            {% form 'localization', id: 'HeaderCountryForm', class: 'mc-loc-form' %}
              <div class="mc-select-wrap">
                <select name="country_code" aria-label="Pays" onchange="this.form.submit()">
                  {% for country in localization.available_countries %}
                    <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                      {% if section.settings.show_country_name %}{{ country.name }}{% else %}{{ country.currency.iso_code }}{% endif %}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endform %}
          </localization-form>
        {% endif %}

        {% if section.settings.enable_locale_selector and localization.available_languages.size > 1 %}
          <localization-form>
            {% form 'localization', id: 'HeaderLanguageForm', class: 'mc-loc-form' %}
              <div class="mc-select-wrap">
                <select name="locale_code" aria-label="Langue" onchange="this.form.submit()">
                  {% for language in localization.available_languages %}
                    <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                      {{ language.endonym_name | capitalize }}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endform %}
          </localization-form>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="mc-header__main">
    <div class="page-width mc-header__main-inner ai-header-container-{{ ai_gen_id }}">
      <button class="mc-header__drawer-btn ai-header-menu-btn-{{ ai_gen_id }}" type="button" aria-label="Open menu" data-mobile-menu-toggle>
        <span></span><span></span><span></span>
      </button>

      <div class="mc-header__logo ai-header-logo-{{ ai_gen_id }}">
  <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
    {% if section.settings.logo != blank %}
      <img
        src="{{ section.settings.logo | image_url: width: 320 }}"
        alt="{{ shop.name }}"
        class="mc-header__logo-image ai-header-logo-normal-{{ ai_gen_id }}"
        loading="eager"
        width="320"
      >
    {% endif %}

    {% if section.settings.white_logo != blank %}
      <img
        src="{{ section.settings.white_logo | image_url: width: 320 }}"
        alt="{{ shop.name }}"
        class="mc-header__logo-image ai-header-logo-white-{{ ai_gen_id }}"
        loading="eager"
        width="320"
      >
    {% elsif section.settings.logo != blank %}
      <img
        src="{{ section.settings.logo | image_url: width: 320 }}"
        alt="{{ shop.name }}"
        class="mc-header__logo-image ai-header-logo-white-{{ ai_gen_id }}"
        loading="eager"
        width="320"
      >
    {% endif %}

    {% if section.settings.logo == blank and section.settings.white_logo == blank %}
      <span class="mc-header__logo-text">{{ shop.name }}</span>
    {% endif %}
  </a>
</div>

      <nav class="mc-header__nav ai-header-nav-{{ ai_gen_id }}" aria-label="Main navigation">
        <ul class="mc-header__nav-list ai-header-nav-list-{{ ai_gen_id }}" role="list">
          {% for link in linklists[section.settings.main_menu].links %}
            <li class="mc-header__nav-item ai-header-nav-item-{{ ai_gen_id }}{% if link.links != blank %} has-dropdown{% endif %}">
              <a href="{{ link.url }}" class="mc-header__nav-link ai-header-nav-link-{{ ai_gen_id }}{% if link.current %} is-active{% endif %}">
                <span>{{ link.title }}</span>
                {% if link.links != blank and section.settings.show_nav_arrows %}
                  <svg class="ai-header-nav-arrow-{{ ai_gen_id }}" viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 7.5 10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {% endif %}
              </a>

              {% if link.links != blank %}
                <div class="mc-mega-menu ai-header-dropdown-{{ ai_gen_id }}">
                  <div class="mc-mega-menu__inner page-width ai-header-container-{{ ai_gen_id }}">
                    <div class="mc-mega-menu__content">
                      <div class="mc-mega-menu__quicklinks">
                        <p class="mc-mega-menu__label">Quick links:</p>
                        <div class="mc-mega-menu__chips">
                          {% for child_link in link.links limit: 8 %}
                            <a href="{{ child_link.url }}" class="mc-chip">{{ child_link.title }}</a>
                          {% endfor %}
                        </div>
                      </div>

                      <div class="mc-mega-menu__grid">
                        <div class="mc-mega-menu__products">
                          <div class="mc-mega-menu__section-head">
                            <h3>{{ link.title }}</h3>
                            {% if section.settings.quiz_label != blank and section.settings.quiz_link != blank %}
                              <a href="{{ section.settings.quiz_link }}" class="mc-outline-btn">{{ section.settings.quiz_label }}</a>
                            {% endif %}
                          </div>

                          {% if section.settings.section_description != blank %}
                            <p class="mc-mega-menu__desc">{{ section.settings.section_description }}</p>
                          {% endif %}

                          <div class="mc-product-cards">
                            {% for block in section.blocks %}
                              {% if block.type == 'product_card' %}
                                <a href="{{ block.settings.link }}" class="mc-product-card" {{ block.shopify_attributes }}>
                                  <div class="mc-product-card__image">
                                    {% if block.settings.image != blank %}
                                      {{ block.settings.image | image_url: width: 180 | image_tag: loading: 'lazy', widths: '90,120,180', alt: block.settings.heading }}
                                    {% endif %}
                                  </div>
                                  <div class="mc-product-card__content">
                                    <h4>{{ block.settings.heading }}</h4>
                                    <p>{{ block.settings.subheading }}</p>
                                  </div>
                                </a>
                              {% endif %}
                            {% endfor %}
                          </div>

                          {% if section.settings.shop_all_label != blank and section.settings.shop_all_link != blank %}
                            <a href="{{ section.settings.shop_all_link }}" class="mc-shop-all">{{ section.settings.shop_all_label }}</a>
                          {% endif %}
                        </div>

                        <aside class="mc-mega-menu__sidebar">
                          {% if section.settings.sidebar_heading != blank %}
                            <h3 class="mc-sidebar-title">{{ section.settings.sidebar_heading }}</h3>
                          {% endif %}

                          <div class="mc-sidebar-card mc-sidebar-card--large">
                            {% if section.settings.sidebar_image_1 != blank %}
                              {{ section.settings.sidebar_image_1 | image_url: width: 700 | image_tag: loading: 'lazy', widths: '320,480,700', alt: section.settings.sidebar_title_1 }}
                            {% endif %}
                            <div class="mc-sidebar-card__body">
                              <h4>{{ section.settings.sidebar_title_1 }}</h4>
                              <p>{{ section.settings.sidebar_text_1 }}</p>
                            </div>
                          </div>

                          <div class="mc-sidebar-card mc-sidebar-card--small">
                            {% if section.settings.sidebar_image_2 != blank %}
                              {{ section.settings.sidebar_image_2 | image_url: width: 500 | image_tag: loading: 'lazy', widths: '240,360,500', alt: section.settings.sidebar_title_2 }}
                            {% endif %}
                            <div class="mc-sidebar-card__body">
                              <h4>{{ section.settings.sidebar_title_2 }}</h4>
                              <p>{{ section.settings.sidebar_text_2 }}</p>
                            </div>
                          </div>
                        </aside>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

    <div class="mc-header__right">
  {% if section.settings.enable_search %}
    <a href="{{ routes.search_url }}" class="mc-search-pill" aria-label="Recherche">
      <svg class="mc-search-pill__icon" viewBox="0 0 1024 1024" aria-hidden="true">
        <path d="M472.576 11.264C222.549333 11.264 19.285333 214.698667 19.285333 464.554667s203.434667 453.290667 453.290667 453.290666c86.869333 0 171.349333-24.746667 244.224-71.338666 11.946667-7.68 15.36-23.381333 7.68-35.328s-23.381333-15.36-35.328-7.68a400.469333 400.469333 0 0 1-216.576 63.317333c-221.696 0-402.090667-180.394667-402.090667-402.090667S250.88 62.464 472.576 62.464s402.090667 180.394667 402.090667 402.090667c0 110.933333-44.202667 214.186667-124.416 290.986666a25.6 25.6 0 0 0 35.328 37.034667c90.453333-86.357333 140.288-202.922667 140.288-328.021333C926.037333 214.528 722.602667 11.264 472.576 11.264z"></path>
        <path d="M997.205333 969.045333l-140.970666-140.970666a25.429333 25.429333 0 0 0-36.181334 0 25.429333 25.429333 0 0 0 0 36.181333l140.970667 140.970667c4.949333 4.949333 11.605333 7.509333 18.090667 7.509333s13.141333-2.56 18.090666-7.509333c10.069333-9.898667 10.069333-26.112 0-36.181334z"></path>
        <path d="M804.352 490.154667c14.165333 0 25.6-11.434667 25.6-25.6 0-196.949333-160.256-357.205333-357.205333-357.205334-14.165333 0-25.6 11.434667-25.6 25.6s11.434667 25.6 25.6 25.6c168.789333 0 306.005333 137.216 306.005333 306.005334 0 14.165333 11.434667 25.6 25.6 25.6z"></path>
      </svg>

      <span class="mc-search-pill__label">{{ section.settings.search_label }}</span>
      <span class="mc-search-pill__typing" data-typing-text></span>
      <span class="mc-search-pill__cursor"></span>
    </a>
  {% endif %}

  <div class="mc-header__icons">
    {% if section.settings.enable_account %}
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Compte" class="mc-header-icon-link">
        <span class="mc-header-icon-wrap">
          <svg class="mc-header-icon mc-header-icon--account" viewBox="0 0 1024 1024" aria-hidden="true">
            <path d="M512 425.130667c112.810667 0 204.629333-91.818667 204.629333-204.629334S624.810667 15.872 512 15.872 307.370667 107.690667 307.370667 220.501333 399.189333 425.130667 512 425.130667z m0-358.058667c84.650667 0 153.429333 68.778667 153.429333 153.429333s-68.778667 153.429333-153.429333 153.429334-153.429333-68.778667-153.429333-153.429334S427.349333 67.072 512 67.072zM512 515.925333c-257.365333 0-466.602667 209.408-466.602667 466.602667 0 14.165333 11.434667 25.6 25.6 25.6h606.890667c14.165333 0 25.6-11.434667 25.6-25.6s-11.434667-25.6-25.6-25.6H97.28C110.592 739.84 291.498667 567.125333 512 567.125333c229.034667 0 415.402667 186.368 415.402667 415.402667 0 14.165333 11.434667 25.6 25.6 25.6s25.6-11.434667 25.6-25.6c0-257.194667-209.237333-466.602667-466.602667-466.602667z"></path>
          </svg>
          {% if section.settings.show_icon_badges %}
            <span class="mc-header-dot"></span>
          {% endif %}
        </span>
      </a>
    {% endif %}

    {% if section.settings.enable_wishlist %}
      <a href="{% if section.settings.wishlist_link != blank %}{{ section.settings.wishlist_link }}{% else %}/pages/wishlist{% endif %}" aria-label="Favoris" class="mc-header-icon-link">
        <span class="mc-header-icon-wrap">
          <svg class="mc-header-icon mc-header-icon--heart" viewBox="0 0 1024 1024" aria-hidden="true">
            <path d="M704.512 236.202667c-14.165333 0-25.6 11.434667-25.6 25.6s11.434667 25.6 25.6 25.6c50.858667 0 92.16 41.301333 92.16 92.16 0 14.165333 11.434667 25.6 25.6 25.6s25.6-11.434667 25.6-25.6c0-79.018667-64.341333-143.36-143.36-143.36z"></path>
            <path d="M1005.056 324.608C986.453333 201.216 887.466667 101.546667 764.416 82.090667 670.208 67.242667 577.877333 97.28 512 162.986667a292.078933 292.078933 0 0 0-232.106667-83.285334c-136.362667 12.117333-246.613333 119.637333-262.314666 255.317334-9.557333 82.602667 15.189333 162.645333 68.437333 224.256 1.024 1.536 2.218667 3.072 3.584 4.608l5.12 5.12c3.925333 4.096 7.850667 8.021333 11.946667 11.946666l0.512 0.512 335.530666 335.530667a96.836267 96.836267 0 0 0 68.949334 28.672h0.170666c25.941333 0 50.517333-10.069333 68.949334-28.501333l352.938666-352.938667c0.341333-0.341333 0.853333-0.853333 1.194667-1.365333 57.514667-64.853333 83.114667-151.552 70.144-238.250667z m-108.373333 204.288l0.512 0.512c-8.533333 7.509333-20.650667 19.626667-39.424 38.4L544.426667 880.810667a46.506667 46.506667 0 0 1-65.536 0L131.242667 533.162667c-48.298667-51.541333-70.997333-120.832-62.805334-192.170667 12.8-111.786667 103.594667-200.192 215.893334-210.432 79.701333-7.338667 157.354667 25.258667 207.872 86.698667 9.728 11.776 29.866667 11.776 39.594666 0 54.613333-66.56 138.752-98.133333 224.597334-84.48 101.376 16.042667 182.784 97.962667 197.973333 199.509333 10.752 71.509333-10.24 143.189333-57.685333 196.608z"></path>
          </svg>
          <span class="mc-header-count">0</span>
        </span>
      </a>
    {% endif %}

    <a href="{{ routes.cart_url }}" aria-label="Panier" class="mc-header-icon-link">
      <span class="mc-header-icon-wrap">
        <svg class="mc-header-icon mc-header-icon--cart" viewBox="0 0 1024 1024" aria-hidden="true">
          <path d="M907.264 847.189333l-8.192-95.573333c-1.194667-14.165333-13.994667-24.405333-27.648-23.381333a25.6 25.6 0 0 0-23.381333 27.648l8.192 94.378666c-0.512 54.954667-45.568 99.498667-100.693334 99.498667H268.458667a100.864 100.864 0 0 1-100.693334-99.498667l41.984-486.058666c0-0.682667 0.170667-1.536 0.170667-2.218667 0-46.592 31.914667-85.845333 75.093333-97.28v180.053333c0 14.165333 11.434667 25.6 25.6 25.6s25.6-11.434667 25.6-25.6V261.461333h348.16v183.466667c0 14.165333 11.434667 25.6 25.6 25.6s25.6-11.434667 25.6-25.6v-180.906667c44.885333 10.069333 78.506667 50.176 78.506667 98.133334 0 0.682667 0 1.536 0.170667 2.218666l26.112 302.933334c1.194667 14.165333 13.653333 24.405333 27.648 23.381333a25.6 25.6 0 0 0 23.381333-27.648L865.28 361.301333c-0.512-76.8-58.538667-140.117333-132.949333-149.333333C714.752 104.789333 622.08 22.869333 510.293333 22.869333c-111.957333 0-204.8 82.090667-222.208 189.269334-72.704 10.752-128.853333 73.216-129.365333 148.821333L116.565333 847.189333c0 0.682667-0.170667 1.536-0.170666 2.218667 0 83.626667 68.096 151.893333 151.893333 151.893333h487.253333c83.797333 0 151.893333-68.096 151.893334-151.893333 0-0.853333 0-1.536-0.170667-2.218667z"></path>
          <path d="M510.293333 74.069333c82.944 0 152.576 58.368 169.984 136.192H340.309333c17.408-77.824 86.869333-136.192 169.984-136.192z"></path>
          <path d="M347.477333 737.962667c-14.165333 0-25.6 11.434667-25.6 25.6s11.434667 25.6 25.6 25.6h353.109334c14.165333 0 25.6-11.434667 25.6-25.6s-11.434667-25.6-25.6-25.6H347.477333z"></path>
        </svg>
        <span class="mc-header-count">{{ cart.item_count }}</span>
      </span>
    </a>
  </div>
</div>
</div>

  <div class="ai-header-drawer-overlay-{{ ai_gen_id }} mc-mobile-drawer__overlay" data-mobile-menu-close data-drawer-overlay></div>

  <div class="mc-mobile-drawer ai-header-mobile-drawer-{{ ai_gen_id }}" data-mobile-drawer>
    <div class="mc-mobile-drawer__panel">
      <div class="mc-mobile-drawer__header">
        <div class="mc-mobile-drawer__logo">
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
            {% if section.settings.logo_mobile != blank %}
              {{ section.settings.logo_mobile | image_url: width: 220 | image_tag: class: 'mc-header__logo-image', loading: 'eager', widths: '120,180,220', alt: shop.name }}
            {% elsif section.settings.logo != blank %}
              {{ section.settings.logo | image_url: width: 220 | image_tag: class: 'mc-header__logo-image', loading: 'eager', widths: '120,180,220', alt: shop.name }}
            {% else %}
              <span class="mc-header__logo-text">{{ shop.name }}</span>
            {% endif %}
          </a>
        </div>

        <button
          class="mc-mobile-drawer__close ai-header-drawer-close-{{ ai_gen_id }}"
          type="button"
          aria-label="Fermer le menu"
          data-mobile-menu-close
          data-drawer-close
        >
          <span>×</span>
        </button>
      </div>

      {% if section.settings.enable_search %}
        <div class="mc-mobile-drawer__search">
          <a href="{{ routes.search_url }}" class="mc-mobile-search-pill" aria-label="Recherche">
            <svg class="mc-mobile-search-pill__icon" viewBox="0 0 1024 1024" aria-hidden="true">
              <path d="M472.576 11.264C222.549333 11.264 19.285333 214.698667 19.285333 464.554667s203.434667 453.290667 453.290667 453.290666c86.869333 0 171.349333-24.746667 244.224-71.338666 11.946667-7.68 15.36-23.381333 7.68-35.328s-23.381333-15.36-35.328-7.68a400.469333 400.469333 0 0 1-216.576 63.317333c-221.696 0-402.090667-180.394667-402.090667-402.090667S250.88 62.464 472.576 62.464s402.090667 180.394667 402.090667 402.090667c0 110.933333-44.202667 214.186667-124.416 290.986666a25.6 25.6 0 0 0 35.328 37.034667c90.453333-86.357333 140.288-202.922667 140.288-328.021333C926.037333 214.528 722.602667 11.264 472.576 11.264z"></path>
              <path d="M997.205333 969.045333l-140.970666-140.970666a25.429333 25.429333 0 0 0-36.181334 0 25.429333 25.429333 0 0 0 0 36.181333l140.970667 140.970667c4.949333 4.949333 11.605333 7.509333 18.090667 7.509333s13.141333-2.56 18.090666-7.509333c10.069333-9.898667 10.069333-26.112 0-36.181334z"></path>
              <path d="M804.352 490.154667c14.165333 0 25.6-11.434667 25.6-25.6 0-196.949333-160.256-357.205333-357.205333-357.205334-14.165333 0-25.6 11.434667-25.6 25.6s11.434667 25.6 25.6 25.6c168.789333 0 306.005333 137.216 306.005333 306.005334 0 14.165333 11.434667 25.6 25.6 25.6z"></path>
            </svg>
            <span>{{ section.settings.search_placeholder }}</span>
          </a>
        </div>
      {% endif %}

      {% if section.settings.enable_account or section.settings.enable_wishlist %}
        <div class="mc-mobile-drawer__quick-actions">
          {% if section.settings.enable_account %}
            <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="mc-mobile-quick-link">
              {% if customer %}Mon compte{% else %}Se connecter{% endif %}
            </a>
          {% endif %}

          {% if section.settings.enable_wishlist %}
            <a href="{% if section.settings.wishlist_link != blank %}{{ section.settings.wishlist_link }}{% else %}/pages/wishlist{% endif %}" class="mc-mobile-quick-link">
              Favoris
            </a>
          {% endif %}
        </div>
      {% endif %}

      <nav aria-label="Mobile navigation">
        <ul class="mc-mobile-drawer__list ai-header-drawer-nav-{{ ai_gen_id }}" role="list">
          {% for link in linklists[section.settings.drawer_menu].links %}
            <li class="mc-mobile-drawer__item {% if link.links != blank %}has-children{% endif %}">
              <div class="mc-mobile-drawer__row">
                <a href="{{ link.url }}" class="mc-mobile-drawer__link">{{ link.title }}</a>

                {% if link.links != blank %}
                  <button
                    type="button"
                    class="mc-mobile-drawer__toggle"
                    aria-expanded="false"
                    aria-label="Ouvrir le sous-menu {{ link.title }}"
                    data-mobile-submenu-toggle
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M5.5 7.5 10 12l4.5-4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {% endif %}
              </div>

              {% if link.links != blank %}
                <ul class="mc-mobile-drawer__submenu" role="list">
                  {% for child_link in link.links %}
                    <li>
                      <a href="{{ child_link.url }}" class="mc-mobile-drawer__sublink">{{ child_link.title }}</a>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>

      <div class="mc-mobile-drawer__footer">
        <a href="{{ routes.cart_url }}" class="mc-mobile-drawer__cart-link">
          Panier <span>({{ cart.item_count }})</span>
        </a>
      </div>
    </div>
  </div>
</header-component-{{ ai_gen_id }}>

<style>
  .mc-header__icons {
  display: flex;
  align-items: center;
  gap: 18px;
  flex: 0 0 auto;
}

.mc-icon-link {
