{% assign section_id = 'momcozy-tabs-manual-' | append: section.id %}

<section id="{{ section_id }}" class="mc-tabs">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="mc-tabs__header">
        <h2 class="mc-tabs__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="mc-tabs__nav" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="mc-tabs__tab{% if forloop.first %} is-active{% endif %}"
            data-tab-target="mc-tab-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_title }}
          </button>
        {% endfor %}
      </div>

      <div class="mc-tabs__panels">
        {% for block in section.blocks %}
          <div
            id="mc-tab-{{ block.id }}"
            class="mc-tabs__panel{% if forloop.first %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="mc-tabs__topbar">
              {% if block.settings.view_all_text != blank %}
                <a class="mc-tabs__view-all" href="{{ block.settings.view_all_link | default: '#' }}">
                  {{ block.settings.view_all_text }}
                  <span aria-hidden="true">→</span>
                </a>
              {% endif %}
            </div>

            <div class="mc-tabs__products">
              {% for i in (1..4) %}
                {% liquid
                  assign enable_key = 'product_' | append: i | append: '_enable'
                  assign title_key = 'product_' | append: i | append: '_title'
                  assign image_key = 'product_' | append: i | append: '_image'
                  assign image2_key = 'product_' | append: i | append: '_image_hover'
                  assign link_key = 'product_' | append: i | append: '_link'
                  assign badge_key = 'product_' | append: i | append: '_badge'
                  assign rating_key = 'product_' | append: i | append: '_rating'
                  assign reviews_key = 'product_' | append: i | append: '_reviews'
                  assign tag1_key = 'product_' | append: i | append: '_tag_1'
                  assign tag2_key = 'product_' | append: i | append: '_tag_2'
                  assign tag3_key = 'product_' | append: i | append: '_tag_3'
                  assign tag4_key = 'product_' | append: i | append: '_tag_4'
                  assign button_key = 'product_' | append: i | append: '_button_text'
                %}

                {% if block.settings[enable_key] %}
                  <div class="mc-card">
                    <div class="mc-card__inner">
                      <div class="mc-card__content">
                        <h3 class="mc-card__title">
                          <a href="{{ block.settings[link_key] | default: '#' }}">
                            {{ block.settings[title_key] }}
                          </a>
                        </h3>

                        {% if block.settings[rating_key] != blank or block.settings[reviews_key] != blank %}
  <div class="mc-card__rating">
    {% assign rating_value = block.settings[rating_key] | default: 0 %}
    {% assign full_stars = rating_value | floor %}
    {% assign decimal = rating_value | minus: full_stars %}
    {% assign has_half = false %}
    {% if decimal >= 0.5 %}
      {% assign has_half = true %}
    {% endif %}
    {% assign next_star = full_stars | plus: 1 %}

    <div class="mc-card__stars" aria-hidden="true">
      {% for s in (1..5) %}
        {% if s <= full_stars %}
          <span>★</span>
        {% elsif has_half and s == next_star %}
          <span>★</span>
        {% else %}
          <span class="is-empty">★</span>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings[reviews_key] != blank %}
      <div class="mc-card__reviews">({{ block.settings[reviews_key] }})</div>
    {% endif %}
  </div>
{% endif %}

                        <div class="mc-card__image-wrap">
                          <a class="mc-card__image-link" href="{{ block.settings[link_key] | default: '#' }}">
                            {% if block.settings[image_key] != blank %}
                              {{
                                block.settings[image_key]
                                | image_url: width: 900
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '320,480,720,900',
                                  class: 'mc-card__image mc-card__image--main',
                                  alt: block.settings[title_key] | escape
                              }}
                            {% endif %}

                            {% if block.settings[image2_key] != blank %}
                              {{
                                block.settings[image2_key]
                                | image_url: width: 900
                                | image_tag:
                                  loading: 'lazy',
                                  widths: '320,480,720,900',
                                  class: 'mc-card__image mc-card__image--hover',
                                  alt: block.settings[title_key] | escape
                              }}
                            {% endif %}
                          </a>

                          {% if block.settings[badge_key] != blank %}
                            <div class="mc-card__badge">
                              {{ block.settings[badge_key] }}
                            </div>
                          {% endif %}
                        </div>

                        <div class="mc-card__tags">
                          {% if block.settings[tag1_key] != blank %}<span>{{ block.settings[tag1_key] }}</span>{% endif %}
                          {% if block.settings[tag2_key] != blank %}<span>{{ block.settings[tag2_key] }}</span>{% endif %}
                          {% if block.settings[tag3_key] != blank %}<span>{{ block.settings[tag3_key] }}</span>{% endif %}
                          {% if block.settings[tag4_key] != blank %}<span>{{ block.settings[tag4_key] }}</span>{% endif %}
                        </div>
                      </div>

                      <div class="mc-card__actions">
                        <a class="mc-card__button" href="{{ block.settings[link_key] | default: '#' }}">
                          {{ block.settings[button_key] | default: 'Shop Now' }}
                        </a>
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="mc-tabs__banners">
              {% for i in (1..2) %}
                {% liquid
                  assign b_enable = 'banner_' | append: i | append: '_enable'
                  assign b_image = 'banner_' | append: i | append: '_image'
                  assign b_title = 'banner_' | append: i | append: '_title'
                  assign b_text = 'banner_' | append: i | append: '_text'
                  assign b_button = 'banner_' | append: i | append: '_button'
                  assign b_link = 'banner_' | append: i | append: '_link'
                %}

                {% if block.settings[b_enable] %}
                  <div class="mc-banner">
                    <div class="mc-banner__inner">
                      {% if block.settings[b_image] != blank %}
                        <a href="{{ block.settings[b_link] | default: '#' }}" class="mc-banner__image-link">
                          {{
                            block.settings[b_image]
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'lazy',
                              widths: '480,720,960,1200,1400',
                              class: 'mc-banner__image',
                              alt: block.settings[b_title] | escape
                          }}
                        </a>
                      {% endif %}

                      <div class="mc-banner__overlay">
                        {% if block.settings[b_title] != blank %}
                          <h3 class="mc-banner__title">{{ block.settings[b_title] }}</h3>
                        {% endif %}

                        {% if block.settings[b_text] != blank %}
                          <div class="mc-banner__text">{{ block.settings[b_text] }}</div>
                        {% endif %}

                        {% if block.settings[b_button] != blank %}
                          <a class="mc-banner__button" href="{{ block.settings[b_link] | default: '#' }}">
                            {{ block.settings[b_button] }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    #{{ section_id }} {
      background: {{ section.settings.bg_color }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      color: {{ section.settings.text_color }};
    }

    #{{ section_id }} .mc-tabs__header {
      margin-bottom: 26px;
    }

    #{{ section_id }} .mc-tabs__title {
      margin: 0;
      font-size: clamp(30px, 4vw, 58px);
      line-height: 1.05;
      font-weight: 800;
      letter-spacing: -0.02em;
      max-width: 700px;
      white-space: pre-line;
    }

    #{{ section_id }} .mc-tabs__nav {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-bottom: 26px;
    }

    #{{ section_id }} .mc-tabs__tab {
      appearance: none;
      border: 0;
      background: {{ section.settings.tab_bg }};
      color: {{ section.settings.tab_text }};
      border-radius: 999px;
      padding: 12px 18px;
      font-size: 14px;
      line-height: 1;
      font-weight: 600;
      cursor: pointer;
      transition: .25s ease;
    }

    #{{ section_id }} .mc-tabs__tab.is-active,
    #{{ section_id }} .mc-tabs__tab:hover {
      background: {{ section.settings.tab_active_bg }};
      color: {{ section.settings.tab_active_text }};
    }

    #{{ section_id }} .mc-tabs__panel {
      display: none;
    }

    #{{ section_id }} .mc-tabs__panel.is-active {
      display: block;
    }

    #{{ section_id }} .mc-tabs__topbar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 18px;
    }

    #{{ section_id }} .mc-tabs__view-all {
      text-decoration: none;
      color: {{ section.settings.text_color }};
      font-size: 15px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border-bottom: 1px solid currentColor;
      padding-bottom: 2px;
    }

    #{{ section_id }} .mc-tabs__products {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 18px;
    }

    #{{ section_id }} .mc-card__inner {
      background: {{ section.settings.card_bg }};
      border-radius: 24px;
      padding: 22px 18px 18px;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
    }

    #{{ section_id }} .mc-card__title {
      margin: 0 0 8px;
      text-align: center;
      font-size: 19px;
      line-height: 1.25;
      font-weight: 500;
      min-height: 52px;
    }

    #{{ section_id }} .mc-card__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ section_id }} .mc-card__rating {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-bottom: 16px;
    }

    #{{ section_id }} .mc-card__stars {
      color: {{ section.settings.star_color }};
      font-size: 18px;
      letter-spacing: 1px;
      line-height: 1;
    }

    #{{ section_id }} .mc-card__stars .is-empty {
      opacity: .25;
    }

    #{{ section_id }} .mc-card__reviews {
      font-size: 13px;
      color: {{ section.settings.muted_text }};
    }

    #{{ section_id }} .mc-card__image-wrap {
      position: relative;
      margin-bottom: 16px;
    }

    #{{ section_id }} .mc-card__image-link {
      position: relative;
      display: block;
      aspect-ratio: 0.92 / 1;
      overflow: hidden;
      border-radius: 18px;
    }

    #{{ section_id }} .mc-card__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: contain;
      transition: opacity .3s ease, transform .4s ease;
    }

    #{{ section_id }} .mc-card__image--hover {
      opacity: 0;
    }

    #{{ section_id }} .mc-card__inner:hover .mc-card__image--hover {
      opacity: 1;
    }

    #{{ section_id }} .mc-card__inner:hover .mc-card__image--main {
      opacity: 0;
    }

    #{{ section_id }} .mc-card__inner:hover .mc-card__image {
      transform: scale(1.03);
    }

    #{{ section_id }} .mc-card__badge {
      position: absolute;
      right: 8px;
      top: 8px;
      width: 62px;
      height: 62px;
      border-radius: 999px;
      background: {{ section.settings.badge_bg }};
      color: {{ section.settings.badge_text }};
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      font-size: 13px;
      line-height: 1.05;
      font-weight: 700;
      padding: 8px;
    }

    #{{ section_id }} .mc-card__tags {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      justify-content: center;
      min-height: 62px;
      margin-bottom: 16px;
    }

    #{{ section_id }} .mc-card__tags span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: {{ section.settings.tag_bg }};
      color: {{ section.settings.tag_text }};
      border-radius: 999px;
      padding: 6px 10px;
      font-size: 11px;
      line-height: 1.1;
      text-align: center;
    }

    #{{ section_id }} .mc-card__actions {
      display: flex;
      justify-content: center;
    }

    #{{ section_id }} .mc-card__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      background: {{ section.settings.button_bg }};
      color: {{ section.settings.button_text }};
      text-decoration: none;
      border-radius: 999px;
      padding: 0 22px;
      font-size: 18px;
      font-weight: 700;
      transition: .25s ease;
    }

    #{{ section_id }} .mc-card__button:hover {
      transform: translateY(-1px);
      opacity: .92;
    }

    #{{ section_id }} .mc-tabs__banners {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    #{{ section_id }} .mc-banner__inner {
      position: relative;
      border-radius: 24px;
      overflow: hidden;
      background: #efe6e0;
      min-height: 380px;
    }

    #{{ section_id }} .mc-banner__image-link,
    #{{ section_id }} .mc-banner__image {
      display: block;
      width: 100%;
      height: 100%;
    }

    #{{ section_id }} .mc-banner__image {
      object-fit: cover;
    }

    #{{ section_id }} .mc-banner__overlay {
      position: absolute;
      left: 24px;
      bottom: 24px;
      max-width: 65%;
      z-index: 2;
    }

    #{{ section_id }} .mc-banner__title {
      margin: 0 0 8px;
      color: {{ section.settings.banner_title_color }};
      font-size: clamp(26px, 2vw, 42px);
      line-height: 1.05;
      font-weight: 800;
    }

    #{{ section_id }} .mc-banner__text {
      margin-bottom: 16px;
      color: {{ section.settings.banner_text_color }};
      font-size: 16px;
      line-height: 1.4;
    }

    #{{ section_id }} .mc-banner__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 24px;
      border-radius: 999px;
      text-decoration: none;
      background: {{ section.settings.banner_button_bg }};
      color: {{ section.settings.banner_button_text }};
      font-weight: 700;
      font-size: 18px;
    }

    @media screen and (max-width: 1199px) {
      #{{ section_id }} .mc-tabs__products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #{{ section_id }} .mc-tabs__products,
      #{{ section_id }} .mc-tabs__banners {
        grid-template-columns: 1fr;
      }

      #{{ section_id }} .mc-tabs__topbar {
        justify-content: flex-start;
      }

      #{{ section_id }} .mc-banner__overlay {
        left: 18px;
        right: 18px;
        bottom: 18px;
        max-width: 85%;
      }

      #{{ section_id }} .mc-card__title {
        font-size: 17px;
      }

      #{{ section_id }} .mc-card__button,
      #{{ section_id }} .mc-banner__button {
        font-size: 16px;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var section = document.getElementById('{{ section_id }}');
      if (!section) return;

      var tabs = section.querySelectorAll('.mc-tabs__tab');
      var panels = section.querySelectorAll('.mc-tabs__panel');

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = this.getAttribute('data-tab-target');

          tabs.forEach(function(btn) {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-selected', 'false');
          });

          panels.forEach(function(panel) {
            panel.classList.remove('is-active');
          });

          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          var activePanel = section.querySelector('#' + target);
          if (activePanel) {
            activePanel.classList.add('is-active');
          }
        });
      });
    });
  </script>
</section>

