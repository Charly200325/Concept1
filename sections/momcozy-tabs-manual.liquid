{% assign section_id = 'tabs-collections-v2-' | append: section.id %}

<section id="{{ section_id }}" class="tabs-v2-section">
  <div class="tabs-v2__inner page-width">
    {% if section.settings.heading != blank %}
      <div class="tabs-v2__header">
        <h2 class="tabs-v2__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign tab_blocks = section.blocks | where: 'type', 'tab' %}

    {% if tab_blocks.size > 0 %}
      <div class="tabs-v2__nav-wrapper">
        <div class="tabs-v2__nav" role="tablist">
          {% for block in tab_blocks %}
            <button
              type="button"
              class="tabs-v2__nav-btn{% if forloop.first %} is-active{% endif %}"
              data-tab-target="tab-{{ block.id }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.tab_title }}
            </button>
          {% endfor %}
        </div>
      </div>

      <div class="tabs-v2__content">
        {% for block in tab_blocks %}
          {% assign collection = collections[block.settings.collection] %}

          <div
            id="tab-{{ block.id }}"
            class="tabs-v2__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            {{ block.shopify_attributes }}
          >
            {% if collection != blank %}
              <div class="tabs-v2__topbar">
                {% if block.settings.view_all_text != blank %}
                  <a class="tabs-v2__view-all" href="{{ collection.url }}">
                    <span>{{ block.settings.view_all_text }}</span>
                    <svg viewBox="0 0 14 10" fill="none" aria-hidden="true">
                      <path d="M8.5 1L13 5L8.5 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                      <path d="M12.5 5H1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </a>
                {% endif %}
              </div>

              <div class="tabs-v2__products grid-cols-{{ block.settings.products_per_row }}">
                {% for product in collection.products limit: block.settings.products_limit %}
                  {% assign first_variant = product.selected_or_first_available_variant %}
                  {% assign second_image = blank %}
                  {% if product.images.size > 1 %}
                    {% assign second_image = product.images[1] %}
                  {% endif %}

                  {% assign promo_tag_1 = product.metafields.custom.promo_tag_1 %}
                  {% assign promo_tag_2 = product.metafields.custom.promo_tag_2 %}
                  {% assign promo_tag_3 = product.metafields.custom.promo_tag_3 %}
                  {% assign promo_tag_4 = product.metafields.custom.promo_tag_4 %}
                  {% assign series_title = product.metafields.custom.series_title %}
                  {% assign learn_more_link = product.metafields.custom.learn_more_link %}
                  {% assign custom_badge = product.metafields.custom.custom_badge %}
                  {% assign custom_rating = product.metafields.custom.rating.value %}
                  {% assign custom_rating_count = product.metafields.custom.rating_count.value %}

                  <div class="tabs-v2__product-card">
                    <div class="tabs-v2__product-wrap">
                      <div class="tabs-v2__product-main">
                        <div class="tabs-v2__product-info">
                          {% if series_title != blank %}
                            <div class="tabs-v2__series">{{ series_title }}</div>
                          {% endif %}

                          <h3 class="tabs-v2__product-title">
                            <a href="{{ product.url }}">{{ product.title }}</a>
                          </h3>

                          {% if custom_rating != blank %}
                            <div class="tabs-v2__rating" aria-label="Rated {{ custom_rating }} out of 5">
                              <div class="tabs-v2__rating-score">{{ custom_rating }}</div>
                              <div class="tabs-v2__stars" aria-hidden="true">
                                {% assign rating_times_20 = custom_rating | times: 20 %}
                                <div class="tabs-v2__stars-bg">★★★★★</div>
                                <div class="tabs-v2__stars-fill" style="width: {{ rating_times_20 }}%;">★★★★★</div>
                              </div>
                              {% if custom_rating_count != blank %}
                                <div class="tabs-v2__rating-count">({{ custom_rating_count }})</div>
                              {% endif %}
                            </div>
                          {% endif %}

                          <div class="tabs-v2__image-wrap">
                            <a class="tabs-v2__image-link" href="{{ product.url }}">
                              {% if product.featured_image %}
                                {{
                                  product.featured_image
                                  | image_url: width: 900
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '220,320,440,550,720,900',
                                    class: 'tabs-v2__image tabs-v2__image--primary',
                                    alt: product.featured_image.alt | escape
                                }}
                              {% endif %}

                              {% if second_image != blank %}
                                {{
                                  second_image
                                  | image_url: width: 900
                                  | image_tag:
                                    loading: 'lazy',
                                    widths: '220,320,440,550,720,900',
                                    class: 'tabs-v2__image tabs-v2__image--secondary',
                                    alt: second_image.alt | escape
                                }}
                              {% endif %}
                            </a>

                            <div class="tabs-v2__badges">
                              {% if custom_badge != blank %}
                                <span class="tabs-v2__badge tabs-v2__badge--custom">
                                  {{ custom_badge }}
                                </span>
                              {% endif %}

                              {% if product.compare_at_price > product.price %}
                                {% assign sale_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                                <span class="tabs-v2__badge tabs-v2__badge--sale">
                                  -{{ sale_percent }}%
                                </span>
                              {% endif %}

                              {% if product.available == false %}
                                <span class="tabs-v2__badge tabs-v2__badge--soldout">
                                  Sold out
                                </span>
                              {% endif %}
                            </div>
                          </div>

                          {% if promo_tag_1 != blank or promo_tag_2 != blank or promo_tag_3 != blank or promo_tag_4 != blank %}
                            <div class="tabs-v2__promo-tags">
                              {% if promo_tag_1 != blank %}<span>{{ promo_tag_1 }}</span>{% endif %}
                              {% if promo_tag_2 != blank %}<span>{{ promo_tag_2 }}</span>{% endif %}
                              {% if promo_tag_3 != blank %}<span>{{ promo_tag_3 }}</span>{% endif %}
                              {% if promo_tag_4 != blank %}<span>{{ promo_tag_4 }}</span>{% endif %}
                            </div>
                          {% endif %}

                          <a class="tabs-v2__full-link" href="{{ product.url }}" aria-label="{{ product.title }}"></a>
                        </div>

                        <div class="tabs-v2__actions">
                          {% if learn_more_link != blank %}
                            <a class="tabs-v2__btn tabs-v2__btn--secondary" href="{{ learn_more_link }}">
                              <span>{{ block.settings.learn_more_text }}</span>
                            </a>
                          {% endif %}

                          <a class="tabs-v2__btn tabs-v2__btn--primary" href="{{ product.url }}">
                            <span>{{ block.settings.shop_now_text }}</span>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if block.settings.banner_1_image != blank or block.settings.banner_2_image != blank %}
                <div class="tabs-v2__banners">
                  {% if block.settings.banner_1_image != blank %}
                    <div class="tabs-v2__banner">
                      <div class="tabs-v2__banner-figure">
                        {% if block.settings.banner_1_link != blank %}
                          <a href="{{ block.settings.banner_1_link }}" class="tabs-v2__banner-image-link">
                        {% endif %}

                        {{
                          block.settings.banner_1_image
                          | image_url: width: 1400
                          | image_tag:
                            loading: 'lazy',
                            widths: '320,480,720,900,1200,1400',
                            class: 'tabs-v2__banner-image',
                            alt: block.settings.banner_1_heading | escape
                        }}

                        {% if block.settings.banner_1_link != blank %}
                          </a>
                        {% endif %}

                        <div class="tabs-v2__banner-content">
                          {% if block.settings.banner_1_heading != blank %}
                            <h3 class="tabs-v2__banner-heading">{{ block.settings.banner_1_heading }}</h3>
                          {% endif %}

                          {% if block.settings.banner_1_text != blank %}
                            <div class="tabs-v2__banner-text">{{ block.settings.banner_1_text }}</div>
                          {% endif %}

                          {% if block.settings.banner_1_button != blank %}
                            <div class="tabs-v2__banner-buttons">
                              <a class="tabs-v2__banner-btn" href="{{ block.settings.banner_1_link | default: '#' }}">
                                {{ block.settings.banner_1_button }}
                              </a>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.banner_2_image != blank %}
                    <div class="tabs-v2__banner">
                      <div class="tabs-v2__banner-figure">
                        {% if block.settings.banner_2_link != blank %}
                          <a href="{{ block.settings.banner_2_link }}" class="tabs-v2__banner-image-link">
                        {% endif %}

                        {{
                          block.settings.banner_2_image
                          | image_url: width: 1400
                          | image_tag:
                            loading: 'lazy',
                            widths: '320,480,720,900,1200,1400',
                            class: 'tabs-v2__banner-image',
                            alt: block.settings.banner_2_heading | escape
                        }}

                        {% if block.settings.banner_2_link != blank %}
                          </a>
                        {% endif %}

                        <div class="tabs-v2__banner-content">
                          {% if block.settings.banner_2_heading != blank %}
                            <h3 class="tabs-v2__banner-heading">{{ block.settings.banner_2_heading }}</h3>
                          {% endif %}

                          {% if block.settings.banner_2_text != blank %}
                            <div class="tabs-v2__banner-text">{{ block.settings.banner_2_text }}</div>
                          {% endif %}

                          {% if block.settings.banner_2_button != blank %}
                            <div class="tabs-v2__banner-buttons">
                              <a class="tabs-v2__banner-btn" href="{{ block.settings.banner_2_link | default: '#' }}">
                                {{ block.settings.banner_2_button }}
                              </a>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% else %}
              <div class="tabs-v2__empty">
                Collection non trouvée pour cet onglet.
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    #{{ section_id }} {
      --tabs-text: {{ section.settings.text_color }};
      --tabs-accent: {{ section.settings.accent_color }};
      --tabs-bg: {{ section.settings.background_color }};
      --tabs-border: {{ section.settings.border_color }};
      --tabs-muted: {{ section.settings.muted_color }};
      --tabs-badge-bg: {{ section.settings.badge_bg }};
      --tabs-badge-text: {{ section.settings.badge_text }};
      --tabs-card-bg: {{ section.settings.card_bg }};
      --tabs-btn-bg: {{ section.settings.button_bg }};
      --tabs-btn-text: {{ section.settings.button_text }};
      --tabs-btn-secondary-border: {{ section.settings.secondary_button_border }};
      --tabs-btn-secondary-text: {{ section.settings.secondary_button_text }};
      background: var(--tabs-bg);
      color: var(--tabs-text);
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #{{ section_id }} .tabs-v2__header {
      text-align: center;
      margin-bottom: 30px;
    }

    #{{ section_id }} .tabs-v2__title {
      margin: 0;
      font-size: clamp(30px, 4vw, 52px);
      line-height: 1.12;
      font-weight: 700;
      letter-spacing: -0.02em;
      white-space: pre-line;
    }

    #{{ section_id }} .tabs-v2__nav-wrapper {
      margin-bottom: 36px;
    }

    #{{ section_id }} .tabs-v2__nav {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
    }

    #{{ section_id }} .tabs-v2__nav-btn {
      appearance: none;
      border: 1px solid var(--tabs-border);
      background: transparent;
      color: var(--tabs-text);
      padding: 11px 20px;
      min-height: 44px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      line-height: 1;
      cursor: pointer;
      transition: all .25s ease;
    }

    #{{ section_id }} .tabs-v2__nav-btn:hover,
    #{{ section_id }} .tabs-v2__nav-btn.is-active {
      background: var(--tabs-accent);
      border-color: var(--tabs-accent);
      color: #fff;
    }

    #{{ section_id }} .tabs-v2__panel {
      display: none;
    }

    #{{ section_id }} .tabs-v2__panel.is-active {
      display: block;
    }

    #{{ section_id }} .tabs-v2__topbar {
      display: flex;
      justify-content: center;
      margin-bottom: 28px;
    }

    #{{ section_id }} .tabs-v2__view-all {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      color: var(--tabs-text);
      border: 1px solid var(--tabs-text);
      padding: 12px 20px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      transition: all .25s ease;
    }

    #{{ section_id }} .tabs-v2__view-all svg {
      width: 14px;
      height: 10px;
    }

    #{{ section_id }} .tabs-v2__view-all:hover {
      background: var(--tabs-text);
      color: #fff;
    }

    #{{ section_id }} .tabs-v2__products {
      display: grid;
      gap: 18px;
      margin-bottom: 32px;
    }

    #{{ section_id }} .tabs-v2__products.grid-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .tabs-v2__products.grid-cols-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ section_id }} .tabs-v2__products.grid-cols-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #{{ section_id }} .tabs-v2__product-card {
      min-width: 0;
    }

    #{{ section_id }} .tabs-v2__product-wrap {
      background: var(--tabs-card-bg);
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid rgba(0,0,0,.06);
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #{{ section_id }} .tabs-v2__product-main {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    #{{ section_id }} .tabs-v2__product-info {
      position: relative;
      padding: 18px 18px 12px;
      flex: 1 1 auto;
    }

    #{{ section_id }} .tabs-v2__series {
      font-size: 13px;
      line-height: 1.2;
      color: var(--tabs-muted);
      margin-bottom: 6px;
      font-weight: 600;
    }

    #{{ section_id }} .tabs-v2__product-title {
      margin: 0 0 10px;
      font-size: 18px;
      line-height: 1.35;
      font-weight: 700;
      position: relative;
      z-index: 2;
    }

    #{{ section_id }} .tabs-v2__product-title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ section_id }} .tabs-v2__rating {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 14px;
      position: relative;
      z-index: 2;
    }

    #{{ section_id }} .tabs-v2__rating-score,
    #{{ section_id }} .tabs-v2__rating-count {
      font-size: 13px;
      color: var(--tabs-text);
    }

    #{{ section_id }} .tabs-v2__stars {
      position: relative;
      line-height: 1;
      font-size: 14px;
      letter-spacing: 1px;
    }

    #{{ section_id }} .tabs-v2__stars-bg {
      color: rgba(0,0,0,.16);
    }

    #{{ section_id }} .tabs-v2__stars-fill {
      position: absolute;
      inset: 0 auto 0 0;
      overflow: hidden;
      white-space: nowrap;
      color: #111;
    }

    #{{ section_id }} .tabs-v2__image-wrap {
      position: relative;
      margin-bottom: 16px;
      border-radius: 16px;
      overflow: hidden;
      background: #f6f6f6;
    }

    #{{ section_id }} .tabs-v2__image-link {
      display: block;
      position: relative;
      aspect-ratio: 0.8 / 1;
      overflow: hidden;
    }

    #{{ section_id }} .tabs-v2__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: opacity .35s ease, transform .45s ease;
    }

    #{{ section_id }} .tabs-v2__image--secondary {
      opacity: 0;
    }

    #{{ section_id }} .tabs-v2__product-wrap:hover .tabs-v2__image--secondary {
      opacity: 1;
    }

    #{{ section_id }} .tabs-v2__product-wrap:hover .tabs-v2__image--primary {
      opacity: 0;
    }

    #{{ section_id }} .tabs-v2__product-wrap:hover .tabs-v2__image {
      transform: scale(1.03);
    }

    #{{ section_id }} .tabs-v2__badges {
      position: absolute;
      top: 12px;
      left: 12px;
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      z-index: 3;
    }

    #{{ section_id }} .tabs-v2__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 28px;
      padding: 5px 10px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: .02em;
    }

    #{{ section_id }} .tabs-v2__badge--custom,
    #{{ section_id }} .tabs-v2__badge--sale,
    #{{ section_id }} .tabs-v2__badge--soldout {
      background: var(--tabs-badge-bg);
      color: var(--tabs-badge-text);
    }

    #{{ section_id }} .tabs-v2__promo-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 12px;
      position: relative;
      z-index: 2;
    }

    #{{ section_id }} .tabs-v2__promo-tags span {
      display: inline-flex;
      align-items: center;
      min-height: 30px;
      padding: 6px 10px;
      border-radius: 999px;
      background: #f3f3f3;
      font-size: 12px;
      line-height: 1.2;
      color: var(--tabs-text);
    }

    #{{ section_id }} .tabs-v2__full-link {
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    #{{ section_id }} .tabs-v2__actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      padding: 0 18px 18px;
      position: relative;
      z-index: 2;
    }

    #{{ section_id }} .tabs-v2__btn {
      position: relative;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      padding: 10px 16px;
      border-radius: 999px;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      transition: all .25s ease;
    }

    #{{ section_id }} .tabs-v2__btn--primary {
      background: var(--tabs-btn-bg);
      color: var(--tabs-btn-text);
    }

    #{{ section_id }} .tabs-v2__btn--primary:hover {
      opacity: .9;
      transform: translateY(-1px);
    }

    #{{ section_id }} .tabs-v2__btn--secondary {
      background: transparent;
      color: var(--tabs-btn-secondary-text);
      border: 1px solid var(--tabs-btn-secondary-border);
    }

    #{{ section_id }} .tabs-v2__btn--secondary:hover {
      background: var(--tabs-btn-secondary-border);
      color: #fff;
    }

    #{{ section_id }} .tabs-v2__banners {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    #{{ section_id }} .tabs-v2__banner {
      min-width: 0;
    }

    #{{ section_id }} .tabs-v2__banner-figure {
      position: relative;
      overflow: hidden;
      border-radius: 18px;
      background: #f5f5f5;
      min-height: 100%;
    }

    #{{ section_id }} .tabs-v2__banner-image-link {
      display: block;
    }

    #{{ section_id }} .tabs-v2__banner-image {
      width: 100%;
      height: auto;
      display: block;
      transition: transform .45s ease;
    }

    #{{ section_id }} .tabs-v2__banner-figure:hover .tabs-v2__banner-image {
      transform: scale(1.03);
    }

    #{{ section_id }} .tabs-v2__banner-content {
      position: absolute;
      left: 24px;
      right: 24px;
      bottom: 24px;
      z-index: 2;
      max-width: 72%;
    }

    #{{ section_id }} .tabs-v2__banner-heading {
      margin: 0 0 8px;
      font-size: clamp(22px, 2.4vw, 30px);
      line-height: 1.1;
      color: #fff;
      font-weight: 700;
      text-shadow: 0 2px 10px rgba(0,0,0,.22);
    }

    #{{ section_id }} .tabs-v2__banner-text {
      margin: 0 0 14px;
      font-size: 14px;
      line-height: 1.45;
      color: #fff;
      text-shadow: 0 2px 10px rgba(0,0,0,.22);
    }

    #{{ section_id }} .tabs-v2__banner-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    #{{ section_id }} .tabs-v2__banner-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 42px;
      padding: 10px 16px;
      border-radius: 999px;
      background: #fff;
      color: #111;
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      transition: all .25s ease;
    }

    #{{ section_id }} .tabs-v2__banner-btn:hover {
      transform: translateY(-1px);
      opacity: .95;
    }

    #{{ section_id }} .tabs-v2__empty {
      text-align: center;
      padding: 24px;
      border: 1px dashed var(--tabs-border);
      border-radius: 12px;
    }

    @media screen and (max-width: 1199px) {
      #{{ section_id }} .tabs-v2__products.grid-cols-4 {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media screen and (max-width: 989px) {
      #{{ section_id }} .tabs-v2__products.grid-cols-4,
      #{{ section_id }} .tabs-v2__products.grid-cols-3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      #{{ section_id }} .tabs-v2__banners {
        grid-template-columns: 1fr;
      }

      #{{ section_id }} .tabs-v2__banner-content {
        max-width: 78%;
      }
    }

    @media screen and (max-width: 749px) {
      #{{ section_id }} {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #{{ section_id }} .tabs-v2__header {
        margin-bottom: 24px;
      }

      #{{ section_id }} .tabs-v2__nav {
        gap: 8px;
      }

      #{{ section_id }} .tabs-v2__nav-btn {
        padding: 10px 14px;
        font-size: 13px;
      }

      #{{ section_id }} .tabs-v2__products.grid-cols-4,
      #{{ section_id }} .tabs-v2__products.grid-cols-3,
      #{{ section_id }} .tabs-v2__products.grid-cols-2 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
      }

      #{{ section_id }} .tabs-v2__product-info {
        padding: 14px 14px 10px;
      }

      #{{ section_id }} .tabs-v2__actions {
        padding: 0 14px 14px;
      }

      #{{ section_id }} .tabs-v2__product-title {
        font-size: 15px;
      }

      #{{ section_id }} .tabs-v2__promo-tags span {
        font-size: 11px;
        padding: 6px 8px;
      }

      #{{ section_id }} .tabs-v2__banner-content {
        left: 18px;
        right: 18px;
        bottom: 18px;
        max-width: 88%;
      }

      #{{ section_id }} .tabs-v2__banner-heading {
        font-size: 22px;
      }

      #{{ section_id }} .tabs-v2__banner-text {
        font-size: 13px;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var section = document.getElementById('{{ section_id }}');
      if (!section) return;

      var buttons = section.querySelectorAll('.tabs-v2__nav-btn');
      var panels = section.querySelectorAll('.tabs-v2__panel');

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          var targetId = this.getAttribute('data-tab-target');

          buttons.forEach(function (btn) {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-selected', 'false');
          });

          panels.forEach(function (panel) {
            panel.classList.remove('is-active');
          });

          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          var activePanel = section.querySelector('#' + targetId);
          if (activePanel) {
            activePanel.classList.add('is-active');
          }
        });
      });
    });
  </script>
</section>

