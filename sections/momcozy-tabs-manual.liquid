  <script>
    (function () {
      function initMcTabs(sectionEl) {
        if (!sectionEl) return;

        var tabs   = sectionEl.querySelectorAll('.mc-tabs__tab');
        var panels = sectionEl.querySelectorAll('.mc-tabs__panel');

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function (e) {
            e.preventDefault();
            var target = this.getAttribute('data-tab-target');

            tabs.forEach(function (btn) {
              btn.classList.remove('is-active');
              btn.setAttribute('aria-selected', 'false');
            });

            panels.forEach(function (panel) {
              panel.classList.remove('is-active');
            });

            this.classList.add('is-active');
            this.setAttribute('aria-selected', 'true');

            var activePanel = sectionEl.querySelector('#' + target);
            if (activePanel) activePanel.classList.add('is-active');
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () {
          initMcTabs(document.getElementById('{{ section_id }}'));
        });
      } else {
        initMcTabs(document.getElementById('{{ section_id }}'));
      }

      /* Shopify theme editor live reload support */
      document.addEventListener('shopify:section:load', function (e) {
        var el = e.target.querySelector('#{{ section_id }}');
        if (el) initMcTabs(el);
      });
    })();
  </script>
</section>

