{% assign section_id = 'momcozy-tabs-manual-' | append: section.id %}

<section id="{{ section_id }}" class="mc-tabs">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="mc-tabs__header">
        <h2 class="mc-tabs__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="mc-tabs__nav" role="tablist">
        {% for block in section.blocks %}
          <button
            type="button"
            class="mc-tabs__tab{% if forloop.first %} is-active{% endif %}"
            data-tab-target="mc-tab-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_title }}
          </button>
        {% endfor %}
      </div>

      <div class="mc-tabs__panels">
        {% for block in section.blocks %}
          <div
            id="mc-tab-{{ block.id }}"
            class="mc-tabs__panel{% if forloop.first %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            <div class="mc-tabs__topbar">
              {% if block.settings.view_all_text != blank %}
                <a class="mc-tabs__view-all" href="{{ block.settings.view_all_link | default: '#' }}">
                  {{ block.settings.view_all_text }}
                  <span aria-hidden="true">→</span>
                </a>
              {% endif %}
            </div>

            {% assign desktop_cols = block.settings.desktop_columns | default: '3' %}
{% assign mobile_cols = block.settings.mobile_columns | default: '1' %}
{% assign enable_desktop_slider = block.settings.enable_desktop_slider %}
{% assign enable_mobile_slider = block.settings.enable_mobile_slider %}

<div class="mc-tabs__products-wrap
  {% if enable_desktop_slider %} is-desktop-slider{% endif %}
  {% if enable_mobile_slider %} is-mobile-slider{% endif %}
">
  <div
    class="mc-tabs__products grid-d-{{ desktop_cols }} grid-m-{{ mobile_cols }}"
  >
    {% assign rendered_products = 0 %}

    {% for i in (1..10) %}
      {% liquid
  assign product_key = 'product_' | append: i
  assign title_key = 'custom_title_' | append: i
  assign show_badge_key = 'show_badge_' | append: i
  assign badge_text_key = 'badge_text_' | append: i
  assign benefit_1_key = 'benefit_1_' | append: i
  assign benefit_2_key = 'benefit_2_' | append: i
  assign benefit_3_key = 'benefit_3_' | append: i
  assign benefit_4_key = 'benefit_4_' | append: i
  assign rating_key = 'rating_' | append: i
  assign reviews_count_key = 'reviews_count_' | append: i

  assign product = block.settings[product_key]
  assign custom_title = block.settings[title_key]
  assign show_badge = block.settings[show_badge_key]
  assign custom_badge_text = block.settings[badge_text_key]
  assign benefit_1 = block.settings[benefit_1_key]
  assign benefit_2 = block.settings[benefit_2_key]
  assign benefit_3 = block.settings[benefit_3_key]
  assign benefit_4 = block.settings[benefit_4_key]
  assign custom_rating = block.settings[rating_key] | default: 5
  assign custom_reviews_count = block.settings[reviews_count_key]
%}

      {% if product != blank %}
        {% assign rendered_products = rendered_products | plus: 1 %}
        {% assign hover_image = blank %}
        {% if product.images.size > 1 %}
          {% assign hover_image = product.images[1] %}
        {% endif %}

        {% assign quick_add_variant = product.selected_or_first_available_variant %}

        <div class="mc-card">
          <div class="mc-card__inner">
            <div class="mc-card__content">
  <div class="mc-card__header">
    <h3 class="mc-card__title">
      <a href="{{ product.url }}">
        {% if custom_title != blank %}
          {{ custom_title }}
        {% else %}
          {{ product.title }}
        {% endif %}
      </a>
    </h3>

    {% if block.settings.show_rating %}
      {% liquid
        assign rating_percentage = custom_rating | times: 20
      %}
      <div class="mc-card__rating">
        <div
          class="mc-card__stars"
          aria-label="Note de {{ custom_rating }} sur 5"
          style="--rating-percent: {{ rating_percentage }}%;"
        >
          <span class="mc-card__stars-bg">★★★★★</span>
          <span class="mc-card__stars-fill">★★★★★</span>
        </div>

        {% if custom_reviews_count != blank %}
          <div class="mc-card__reviews">({{ custom_reviews_count }})</div>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="mc-card__image-wrap">
                <a class="mc-card__image-link" href="{{ product.url }}">
                  {% if product.featured_image != blank %}
                    {{
                      product.featured_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360,535,720,900,1200',
                        class: 'mc-card__image mc-card__image--main',
                        alt: product.title | escape
                    }}
                  {% endif %}

                  {% if hover_image != blank %}
                    {{
                      hover_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '360,535,720,900,1200',
                        class: 'mc-card__image mc-card__image--hover',
                        alt: product.title | escape
                    }}
                  {% endif %}
                </a>

                {% if block.settings.show_badges and show_badge and custom_badge_text != blank %}
                  <div class="mc-card__badge">{{ custom_badge_text }}</div>
                {% endif %}
              </div>

              {% if block.settings.show_benefits %}
                <div class="mc-card__tags">
                  {% if benefit_1 != blank %}<span>{{ benefit_1 }}</span>{% endif %}
                  {% if benefit_2 != blank %}<span>{{ benefit_2 }}</span>{% endif %}
                  {% if benefit_3 != blank %}<span>{{ benefit_3 }}</span>{% endif %}
                  {% if benefit_4 != blank %}<span>{{ benefit_4 }}</span>{% endif %}
                </div>
              {% endif %}

              {% if block.settings.show_price %}
                <div class="mc-card__price">
                  {% if product.compare_at_price > product.price %}
                    <span class="mc-card__price-sale">{{ product.price | money }}</span>
                    <span class="mc-card__price-compare">{{ product.compare_at_price | money }}</span>
                  {% else %}
                    <span class="mc-card__price-regular">{{ product.price | money }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="mc-card__actions">
              {% if block.settings.enable_quick_add and quick_add_variant != blank and product.available %}
                {% form 'product', product, class: 'mc-card__quick-add-form' %}
                  <input type="hidden" name="id" value="{{ quick_add_variant.id }}">
                  <button type="submit" class="mc-card__button">
                    {{ block.settings.quick_add_text }}
                  </button>
                {% endform %}
              {% else %}
                <a class="mc-card__button" href="{{ product.url }}">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}

    {% if rendered_products == 0 %}
      <div class="mc-empty">
        Sélectionne au moins un produit dans cet onglet.
      </div>
    {% endif %}
  </div>
</div>

            <div class="mc-tabs__banners">
              {% for i in (1..2) %}
                {% liquid
                  assign b_enable = 'banner_' | append: i | append: '_enable'
                  assign b_image = 'banner_' | append: i | append: '_image'
                  assign b_title = 'banner_' | append: i | append: '_title'
                  assign b_text = 'banner_' | append: i | append: '_text'
                  assign b_button = 'banner_' | append: i | append: '_button'
                  assign b_link = 'banner_' | append: i | append: '_link'
                %}

                {% if block.settings[b_enable] %}
                  <div class="mc-banner">
                    <div class="mc-banner__inner">
                      {% if block.settings[b_image] != blank %}
                        <a href="{{ block.settings[b_link] | default: '#' }}" class="mc-banner__image-link">
                          {{
                            block.settings[b_image]
                            | image_url: width: 1400
                            | image_tag:
                              loading: 'lazy',
                              widths: '480,720,960,1200,1400',
                              class: 'mc-banner__image',
                              alt: block.settings[b_title] | escape
                          }}
                        </a>
                      {% endif %}

                      <div class="mc-banner__overlay">
                        {% if block.settings[b_title] != blank %}
                          <h3 class="mc-banner__title">{{ block.settings[b_title] }}</h3>
                        {% endif %}

                        {% if block.settings[b_text] != blank %}
                          <div class="mc-banner__text">{{ block.settings[b_text] }}</div>
                        {% endif %}

                        {% if block.settings[b_button] != blank %}
                          <a class="mc-banner__button" href="{{ block.settings[b_link] | default: '#' }}">
                            {{ block.settings[b_button] }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

 <style>
  #{{ section_id }} {
    background: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    color: {{ section.settings.text_color }};
  }

  #{{ section_id }} .mc-tabs__header {
    margin-bottom: 24px;
  }

  #{{ section_id }} .mc-tabs__title {
    margin: 0;
    font-size: clamp(34px, 5vw, 66px);
    line-height: 0.98;
    font-weight: 600;
    letter-spacing: -0.04em;
    max-width: 760px;
    white-space: pre-line;
  }

  #{{ section_id }} .mc-tabs__nav {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  #{{ section_id }} .mc-tabs__tab {
    appearance: none;
    border: 0;
    background: {{ section.settings.tab_bg }};
    color: {{ section.settings.tab_text }};
    border-radius: 999px;
    padding: 13px 18px;
    font-size: 14px;
    line-height: 1;
    font-weight: 500;
    cursor: pointer;
    transition: .25s ease;
  }

  #{{ section_id }} .mc-tabs__tab.is-active,
  #{{ section_id }} .mc-tabs__tab:hover {
    background: {{ section.settings.tab_active_bg }};
    color: {{ section.settings.tab_active_text }};
  }

  #{{ section_id }} .mc-tabs__panel {
    display: none;
  }

  #{{ section_id }} .mc-tabs__panel.is-active {
    display: block;
  }

  #{{ section_id }} .mc-tabs__topbar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 18px;
  }

  #{{ section_id }} .mc-tabs__view-all {
    text-decoration: none;
    color: {{ section.settings.text_color }};
    font-size: 16px;
    font-weight: 400;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }

  #{{ section_id }} .mc-tabs__products-wrap {
    overflow: visible;
    margin-bottom: 18px;
  }

  #{{ section_id }} .mc-tabs__products {
    display: grid;
    gap: 18px;
    justify-content: center;
  }

  #{{ section_id }} .mc-tabs__products.grid-d-2 { grid-template-columns: repeat(2, minmax(0, 373.75px)); }
  #{{ section_id }} .mc-tabs__products.grid-d-3 { grid-template-columns: repeat(3, minmax(0, 373.75px)); }
  #{{ section_id }} .mc-tabs__products.grid-d-4 { grid-template-columns: repeat(4, minmax(0, 373.75px)); }
  #{{ section_id }} .mc-tabs__products.grid-d-5 { grid-template-columns: repeat(5, minmax(0, 373.75px)); }

  #{{ section_id }} .mc-card {
    min-width: 0;
    width: 100%;
    max-width: 373.75px;
  }

  #{{ section_id }} .mc-card__inner {
    background: {{ section.settings.card_bg }};
    border-radius: 28px;
    padding: 26px 22px 24px;
    min-height: 586px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  #{{ section_id }} .mc-card__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 10px;
  }

  #{{ section_id }} .mc-card__title {
    margin: 0 0 6px;
    text-align: center;
    font-size: 17px;
    line-height: 1.18;
    font-weight: 400;
    min-height: unset;
    max-width: 92%;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .mc-card__title a {
    color: inherit;
    text-decoration: none;
  }

  #{{ section_id }} .mc-card__rating {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 0;
    margin-bottom: 0;
  }

  #{{ section_id }} .mc-card__stars {
    position: relative;
    display: inline-block;
    font-size: 16px;
    line-height: 1;
    letter-spacing: 1px;
  }

  #{{ section_id }} .mc-card__stars-bg {
    color: #d8d8d8;
  }

  #{{ section_id }} .mc-card__stars-fill {
    color: {{ section.settings.star_color }};
    position: absolute;
    top: 0;
    left: 0;
    width: var(--rating-percent, 100%);
    overflow: hidden;
    white-space: nowrap;
  }

  #{{ section_id }} .mc-card__reviews {
    font-size: 13px;
    color: #555;
    line-height: 1;
    font-weight: 400;
  }

  #{{ section_id }} .mc-card__image-wrap {
    position: relative;
    margin-top: 4px;
    margin-bottom: 16px;
  }

  #{{ section_id }} .mc-card__image-link {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1.02;
    overflow: hidden;
    border-radius: 22px;
    background: transparent;
  }

  #{{ section_id }} .mc-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    transition: opacity .28s ease, transform .35s ease;
  }

  #{{ section_id }} .mc-card__image--main {
    opacity: 1;
    z-index: 1;
  }

  #{{ section_id }} .mc-card__image--hover {
    opacity: 0;
    z-index: 2;
  }

  #{{ section_id }} .mc-card__inner:hover .mc-card__image--main {
    opacity: 0;
  }

  #{{ section_id }} .mc-card__inner:hover .mc-card__image--hover {
    opacity: 1;
  }

  #{{ section_id }} .mc-card__inner:hover .mc-card__image {
    transform: scale(1.02);
  }

  #{{ section_id }} .mc-card__badge {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text }};
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-size: 8.5px;
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 6px;
    z-index: 2;
  }

  #{{ section_id }} .mc-card__tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 8px;
    margin-bottom: 18px;
    max-width: 82%;
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }} .mc-card__tags span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 0 12px;
    background: #f7f7f7;
    color: #3f3f3f;
    border-radius: 999px;
    font-size: 8px;
    line-height: 1;
    text-align: center;
    white-space: nowrap;
    font-weight: 400;
    letter-spacing: 0;
  }

  #{{ section_id }} .mc-card__price {
    text-align: center;
    margin-bottom: 18px;
    font-size: 17px;
    font-weight: 600;
  }

  #{{ section_id }} .mc-card__price-sale,
  #{{ section_id }} .mc-card__price-regular {
    color: {{ section.settings.text_color }};
    font-weight: 600;
  }

  #{{ section_id }} .mc-card__price-compare {
    color: #7c7c7c;
    text-decoration: line-through;
    font-weight: 400;
    margin-left: 10px;
  }

  #{{ section_id }} .mc-card__actions {
    display: flex;
    justify-content: center;
  }

  #{{ section_id }} .mc-card__quick-add-form {
    display: flex;
    justify-content: center;
  }

  #{{ section_id }} .mc-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    min-width: 220px;
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    text-decoration: none;
    border-radius: 999px;
    padding: 0 22px;
    font-size: 14px;
    font-weight: 600;
    transition: .25s ease;
    border: 0;
    cursor: pointer;
    box-shadow: none;
  }

  #{{ section_id }} .mc-card__button:hover {
    transform: translateY(-1px);
    opacity: .92;
  }

  #{{ section_id }} .mc-tabs__banners {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  #{{ section_id }} .mc-banner__inner {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    background: #efe6e0;
    min-height: 360px;
  }

  #{{ section_id }} .mc-banner__image-link,
  #{{ section_id }} .mc-banner__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .mc-banner__image {
    object-fit: cover;
  }

  #{{ section_id }} .mc-banner__overlay {
    position: absolute;
    left: 24px;
    bottom: 24px;
    max-width: 68%;
    z-index: 2;
  }

  #{{ section_id }} .mc-banner__title {
    margin: 0 0 8px;
    color: {{ section.settings.banner_title_color }};
    font-size: clamp(26px, 2vw, 42px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  #{{ section_id }} .mc-banner__text {
    margin-bottom: 16px;
    color: {{ section.settings.banner_text_color }};
    font-size: 15px;
    line-height: 1.35;
    font-weight: 400;
  }

  #{{ section_id }} .mc-banner__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    text-decoration: none;
    background: {{ section.settings.banner_button_bg }};
    color: {{ section.settings.banner_button_text }};
    font-weight: 600;
    font-size: 15px;
  }

  #{{ section_id }} .mc-empty {
    grid-column: 1 / -1;
    background: #fff;
    border-radius: 18px;
    padding: 30px;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    #{{ section_id }} .mc-tabs__products-wrap.is-desktop-slider {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 4px;
      scrollbar-width: thin;
      scroll-snap-type: x mandatory;
    }

    #{{ section_id }} .mc-tabs__products-wrap.is-desktop-slider .mc-tabs__products {
      display: flex;
      flex-wrap: nowrap;
      gap: 18px;
      width: max-content;
      min-width: 100%;
      justify-content: flex-start;
    }

    #{{ section_id }} .mc-tabs__products-wrap.is-desktop-slider .mc-card {
      width: 373.75px;
      min-width: 373.75px;
      max-width: 373.75px;
      flex: 0 0 373.75px;
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 1199px) {
    #{{ section_id }} .mc-tabs__products.grid-d-4,
    #{{ section_id }} .mc-tabs__products.grid-d-5 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #{{ section_id }} .mc-tabs__title {
      font-size: clamp(24px, 7vw, 44px);
      line-height: 1.02;
      max-width: 360px;
      margin-bottom: 2px;
    }

    #{{ section_id }} .mc-tabs__nav {
      gap: 10px;
      margin-bottom: 20px;
    }

    #{{ section_id }} .mc-tabs__tab {
      padding: 12px 16px;
      font-size: 14px;
    }

    #{{ section_id }} .mc-tabs__topbar {
      justify-content: center;
      margin-bottom: 16px;
    }

    #{{ section_id }} .mc-tabs__view-all {
      font-size: 15px;
    }

    #{{ section_id }} .mc-tabs__products.grid-m-1 {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .mc-tabs__products.grid-m-2 {
      grid-template-columns: repeat(2, minmax(0, 190px));
      justify-content: center;
      gap: 12px;
    }

    #{{ section_id }} .mc-card {
      width: 190px;
      min-width: 190px;
      max-width: 190px;
    }

    #{{ section_id }} .mc-card__inner {
      border-radius: 24px;
      padding: 20px 14px 20px;
      min-height: 389.28px;
    }

    #{{ section_id }} .mc-card__header {
      margin-bottom: 8px;
    }

    #{{ section_id }} .mc-card__title {
      font-size: 15px;
      min-height: unset;
      margin-bottom: 6px;
      line-height: 1.2;
      letter-spacing: -0.02em;
      max-width: 94%;
    }

    #{{ section_id }} .mc-card__rating {
      gap: 7px;
      margin-top: 0;
      margin-bottom: 0;
    }

    #{{ section_id }} .mc-card__stars {
      font-size: 14px;
    }

    #{{ section_id }} .mc-card__reviews {
      font-size: 11px;
    }

    #{{ section_id }} .mc-card__image-wrap {
      margin-top: 4px;
      margin-bottom: 14px;
    }

    #{{ section_id }} .mc-card__image-link {
      aspect-ratio: 1 / 1;
      border-radius: 18px;
    }

    #{{ section_id }} .mc-card__badge {
      top: 8px;
      right: 8px;
      width: 44px;
      height: 44px;
      font-size: 7px;
      line-height: 1.08;
      padding: 4px;
    }

    #{{ section_id }} .mc-card__tags {
      gap: 6px 6px;
      margin-bottom: 12px;
      max-width: 84%;
    }

    #{{ section_id }} .mc-card__tags span {
      min-height: 24px;
      padding: 0 10px;
      font-size: 7px;
      line-height: 1;
      border-radius: 999px;
      background: #f7f7f7;
      color: #3f3f3f;
      letter-spacing: 0;
    }

    #{{ section_id }} .mc-card__price {
      font-size: 13px;
      margin-bottom: 12px;
    }

    #{{ section_id }} .mc-card__button {
      min-height: 44px;
      min-width: 160px;
      font-size: 12px;
      padding: 0 18px;
    }

    #{{ section_id }} .mc-tabs__banners {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .mc-banner__overlay {
      left: 18px;
      right: 18px;
      bottom: 18px;
      max-width: 86%;
    }

    #{{ section_id }} .mc-banner__title {
      font-size: 24px;
    }

    #{{ section_id }} .mc-banner__text {
      font-size: 14px;
    }

    #{{ section_id }} .mc-banner__button {
      font-size: 14px;
      min-height: 40px;
    }

    #{{ section_id }} .mc-tabs__products-wrap.is-mobile-slider {
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 4px;
      scrollbar-width: none;
      -ms-overflow-style: none;
      scroll-snap-type: x mandatory;
    }

    #{{ section_id }} .mc-tabs__products-wrap.is-mobile-slider::-webkit-scrollbar {
      display: none;
    }

    #{{ section_id }} .mc-tabs__products-wrap.is-mobile-slider .mc-tabs__products {
      display: flex;
      flex-wrap: nowrap;
      gap: 12px;
      width: max-content;
      min-width: 100%;
      justify-content: flex-start;
    }

    #{{ section_id }} .mc-tabs__products-wrap.is-mobile-slider .mc-card {
      width: 190px;
      min-width: 190px;
      max-width: 190px;
      flex: 0 0 190px;
      scroll-snap-align: start;
    }
  }
</style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var section = document.getElementById('{{ section_id }}');
      if (!section) return;

      var tabs = section.querySelectorAll('.mc-tabs__tab');
      var panels = section.querySelectorAll('.mc-tabs__panel');

      tabs.forEach(function(tab) {
        tab.addEventListener('click', function() {
          var target = this.getAttribute('data-tab-target');

          tabs.forEach(function(btn) {
            btn.classList.remove('is-active');
            btn.setAttribute('aria-selected', 'false');
          });

          panels.forEach(function(panel) {
            panel.classList.remove('is-active');
          });

          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          var activePanel = section.querySelector('#' + target);
          if (activePanel) {
            activePanel.classList.add('is-active');
          }
        });
      });
    });
  </script>
</section>

