{% assign section_id = 'momcozy-tabs-manual-' | append: section.id %}

<section id="{{ section_id }}" class="mc-tabs">
  <div class="mc-tabs__container">
    {% if section.settings.heading != blank %}
      <div class="mc-tabs__header">
        <h2 class="mc-tabs__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="mc-tabs__nav-wrap">
        <ul class="mc-tabs__nav" role="tablist">
          {% for block in section.blocks %}
            <li class="mc-tabs__tab-item{% if forloop.first %} is-active{% endif %}">
              <a
                href="#mc-tab-{{ block.id }}"
                class="mc-tabs__tab{% if forloop.first %} is-active{% endif %}"
                role="tab"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                data-tab-target="mc-tab-{{ block.id }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.tab_title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>

      <div class="mc-tabs__panels">
        {% for block in section.blocks %}
          <div
            id="mc-tab-{{ block.id }}"
            class="mc-tabs__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            {{ block.shopify_attributes }}
          >
            {%- comment -%} View All Button {%- endcomment -%}
            {% if block.settings.view_all_text != blank %}
              <div class="mc-tabs__viewall-wrap">
                <a
                  class="mc-tabs__viewall-btn"
                  href="{{ block.settings.view_all_link | default: '#' }}"
                >
                  {{ block.settings.view_all_text }}
                  <svg class="mc-tabs__viewall-icon" viewBox="0 0 14 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M9 1L13 5L9 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <line x1="1" y1="5" x2="13" y2="5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </a>
              </div>
            {% endif %}

            {%- comment -%} Products Grid {%- endcomment -%}
            {% assign desktop_cols = block.settings.desktop_columns | default: '4' %}
            {% assign mobile_cols = block.settings.mobile_columns | default: '2' %}
            {% assign enable_desktop_slider = block.settings.enable_desktop_slider %}
            {% assign enable_mobile_slider = block.settings.enable_mobile_slider %}

            <div class="mc-products-wrap{% if enable_desktop_slider %} is-desktop-slider{% endif %}{% if enable_mobile_slider %} is-mobile-slider{% endif %}">
              <div class="mc-products t4s-row-cols-lg-{{ desktop_cols }} t4s-row-cols-{{ mobile_cols }}">
                {% assign rendered_products = 0 %}

                {% for i in (1..10) %}
                  {% liquid
                    assign product_key         = 'product_' | append: i
                    assign series_key          = 'series_title_' | append: i
                    assign title_key           = 'custom_title_' | append: i
                    assign show_badge_key      = 'show_badge_' | append: i
                    assign badge_text_key      = 'badge_text_' | append: i
                    assign benefit_1_key       = 'benefit_1_' | append: i
                    assign benefit_2_key       = 'benefit_2_' | append: i
                    assign benefit_3_key       = 'benefit_3_' | append: i
                    assign benefit_4_key       = 'benefit_4_' | append: i
                    assign rating_key          = 'rating_' | append: i
                    assign reviews_count_key   = 'reviews_count_' | append: i
                    assign show_learn_key      = 'show_learn_more_' | append: i
                    assign learn_link_key      = 'learn_more_link_' | append: i
                    assign custom_url_key      = 'custom_url_' | append: i

                    assign product            = block.settings[product_key]
                    assign series_title       = block.settings[series_key]
                    assign custom_title       = block.settings[title_key]
                    assign show_badge         = block.settings[show_badge_key]
                    assign custom_badge_text  = block.settings[badge_text_key]
                    assign benefit_1          = block.settings[benefit_1_key]
                    assign benefit_2          = block.settings[benefit_2_key]
                    assign benefit_3          = block.settings[benefit_3_key]
                    assign benefit_4          = block.settings[benefit_4_key]
                    assign custom_rating      = block.settings[rating_key] | default: 5
                    assign custom_reviews_count = block.settings[reviews_count_key]
                    assign show_learn_more    = block.settings[show_learn_key]
                    assign learn_more_link    = block.settings[learn_link_key]
                    assign custom_url         = block.settings[custom_url_key]
                  %}

                  {% if product != blank %}
                    {% assign rendered_products = rendered_products | plus: 1 %}
                    {% assign hover_image = blank %}
                    {% if product.images.size > 1 %}
                      {% assign hover_image = product.images[1] %}
                    {% endif %}

                    {% assign product_url = product.url %}
                    {% if custom_url != blank %}
                      {% assign product_url = custom_url %}
                    {% endif %}

                    {% assign quick_add_variant = product.selected_or_first_available_variant %}

                    <div class="mc-product t4s-col-item">
                      <div class="mc-product__wrapper">
                        <div class="mc-product__inner">

                          {%- comment -%} Product Info Top {%- endcomment -%}
                          <div class="mc-product__info">
                            {% if series_title != blank %}
                              <div class="mc-product__series">{{ series_title }}</div>
                            {% endif %}

                            <h3 class="mc-product__title">
                              <a href="{{ product_url }}">
                                {% if custom_title != blank %}
                                  {{ custom_title }}
                                {% else %}
                                  {{ product.title }}
                                {% endif %}
                              </a>
                            </h3>

                            {% if block.settings.show_rating %}
                              {% liquid
                                assign rating_percentage = custom_rating | times: 20
                              %}
                              <div class="mc-product__rating">
                                <div class="mc-product__stars" aria-label="Note de {{ custom_rating }} sur 5" style="--rating-percent: {{ rating_percentage }}%;">
                                  <div class="mc-product__stars-bg">
                                    <svg height="16" viewBox="0 0 88 16" aria-hidden="true"><use x="0" href="#mc-star-empty"></use><use x="18" href="#mc-star-empty"></use><use x="36" href="#mc-star-empty"></use><use x="54" href="#mc-star-empty"></use><use x="72" href="#mc-star-empty"></use></svg>
                                  </div>
                                  <div class="mc-product__stars-fill" style="width: {{ rating_percentage }}%;">
                                    <svg height="16" viewBox="0 0 88 16" aria-hidden="true"><use x="0" href="#mc-star-filled"></use><use x="18" href="#mc-star-filled"></use><use x="36" href="#mc-star-filled"></use><use x="54" href="#mc-star-filled"></use><use x="72" href="#mc-star-filled"></use></svg>
                                  </div>
                                </div>
                                {% if custom_reviews_count != blank %}
                                  <span class="mc-product__reviews">({{ custom_reviews_count }})</span>
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>

                          {%- comment -%} Product Image {%- endcomment -%}
                          <div class="mc-product__image-wrap">
                            <div class="mc-product__image-ratio{% if hover_image != blank %} is-show-img2{% endif %}">
                              <a href="{{ product_url }}" class="mc-product__image-link">
                                {% if product.featured_image != blank %}
                                  {{
                                    product.featured_image
                                    | image_url: width: 768
                                    | image_tag:
                                      loading: 'lazy',
                                      widths: '360,440,768',
                                      class: 'mc-product__img mc-product__img--main',
                                      alt: product.title | escape
                                  }}
                                {% endif %}

                                {% if hover_image != blank %}
                                  {{
                                    hover_image
                                    | image_url: width: 768
                                    | image_tag:
                                      loading: 'lazy',
                                      widths: '360,440,768',
                                      class: 'mc-product__img mc-product__img--hover',
                                      alt: product.title | escape
                                  }}
                                {% endif %}
                              </a>

                              {%- comment -%} Badge {%- endcomment -%}
                              <div class="mc-product__badge-wrap">
                                {% if block.settings.show_badges and show_badge and custom_badge_text != blank %}
                                  <span class="mc-product__badge mc-product__badge--custom mc-product__badge--{{ custom_badge_text | downcase | replace: ' ', '-' }}">
                                    {{ custom_badge_text }}
                                  </span>
                                {% endif %}
                                {% if product.compare_at_price > product.price %}
                                  {% assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                                  <span class="mc-product__badge mc-product__badge--sale">-{{ discount_pct }}%</span>
                                {% endif %}
                              </div>
                            </div>
                          </div>

                          {%- comment -%} Benefits / Special Promotion {%- endcomment -%}
                          {% if block.settings.show_benefits %}
                            {% assign has_benefits = false %}
                            {% if benefit_1 != blank or benefit_2 != blank or benefit_3 != blank or benefit_4 != blank %}
                              {% assign has_benefits = true %}
                            {% endif %}
                            {% if has_benefits %}
                              <div class="mc-product__promotion">
                                {% if benefit_1 != blank %}<span class="mc-promotion-tag">{{ benefit_1 }}</span>{% endif %}
                                {% if benefit_2 != blank %}<span class="mc-promotion-tag">{{ benefit_2 }}</span>{% endif %}
                                {% if benefit_3 != blank %}<span class="mc-promotion-tag">{{ benefit_3 }}</span>{% endif %}
                                {% if benefit_4 != blank %}<span class="mc-promotion-tag">{{ benefit_4 }}</span>{% endif %}
                              </div>
                            {% endif %}
                          {% endif %}

                          {%- comment -%} Full width link (invisible, z-index below buttons) {%- endcomment -%}
                          <a class="mc-product__full-link" href="{{ product_url }}" aria-hidden="true" tabindex="-1"></a>

                        </div>

                        {%- comment -%} Action Buttons {%- endcomment -%}
                        <div class="mc-product__info1">
                          {% if show_learn_more and learn_more_link != blank %}
                            <div class="mc-product__btns mc-product__btns--secondary">
                              <a href="{{ learn_more_link }}" class="mc-btn mc-btn--outline">
                                <span>{{ block.settings.learn_more_text | default: 'Learn More' }}</span>
                              </a>
                            </div>
                          {% endif %}

                          <div class="mc-product__btns mc-product__btns--primary">
                            {% if block.settings.enable_quick_add and quick_add_variant != blank and product.available %}
                              {% form 'product', product, class: 'mc-product__quick-add-form' %}
                                <input type="hidden" name="id" value="{{ quick_add_variant.id }}">
                                <button type="submit" class="mc-btn mc-btn--primary">
                                  <span>{{ block.settings.quick_add_text | default: 'Ajouter au panier' }}</span>
                                </button>
                              {% endform %}
                            {% else %}
                              <a href="{{ product_url }}" class="mc-btn mc-btn--primary">
                                <span>{{ block.settings.button_text | default: 'Shop Now' }}</span>
                              </a>
                            {% endif %}
                          </div>
                        </div>

                      </div>
                    </div>
                  {% endif %}
                {% endfor %}

                {% if rendered_products == 0 %}
                  <div class="mc-empty">
                    Sélectionne au moins un produit dans cet onglet.
                  </div>
                {% endif %}
              </div>
            </div>

            {%- comment -%} Additional Grid (Banners) — style Momcozy w__addiGrid {%- endcomment -%}
            {% assign has_any_banner = false %}
            {% for i in (1..2) %}
              {% liquid
                assign b_enable = 'banner_' | append: i | append: '_enable'
              %}
              {% if block.settings[b_enable] %}
                {% assign has_any_banner = true %}
              {% endif %}
            {% endfor %}

            {% if has_any_banner %}
              <div class="mc-addi-grid">
                {% for i in (1..2) %}
                  {% liquid
                    assign b_enable  = 'banner_' | append: i | append: '_enable'
                    assign b_image   = 'banner_' | append: i | append: '_image'
                    assign b_title   = 'banner_' | append: i | append: '_title'
                    assign b_text    = 'banner_' | append: i | append: '_text'
                    assign b_button1 = 'banner_' | append: i | append: '_button'
                    assign b_link    = 'banner_' | append: i | append: '_link'
                    assign b_button2 = 'banner_' | append: i | append: '_button2'
                    assign b_link2   = 'banner_' | append: i | append: '_link2'
                  %}

                  {% if block.settings[b_enable] %}
                    <div class="mc-addi-col">
                      <figure class="mc-addi-figure">
                        {% if block.settings[b_image] != blank %}
                          <a href="{{ block.settings[b_link] | default: '#' }}" class="mc-addi-picture-link">
                            {{
                              block.settings[b_image]
                              | image_url: width: 1400
                              | image_tag:
                                loading: 'lazy',
                                widths: '480,720,960,1200,1400',
                                class: 'mc-addi-picture',
                                alt: block.settings[b_title] | escape
                            }}
                          </a>
                        {% endif %}

                        <div class="mc-addi-overlay">
                          {% if block.settings[b_title] != blank %}
                            <h3 class="mc-addi-heading">{{ block.settings[b_title] }}</h3>
                          {% endif %}
                          {% if block.settings[b_text] != blank %}
                            <h4 class="mc-addi-subheading">{{ block.settings[b_text] }}</h4>
                          {% endif %}
                          <div class="mc-addi-buttons">
                            {% if block.settings[b_button1] != blank %}
                              <a class="mc-addi-btn" href="{{ block.settings[b_link] | default: '#' }}">
                                {{ block.settings[b_button1] }}
                              </a>
                            {% endif %}
                            {% if block.settings[b_button2] != blank %}
                              <a class="mc-addi-btn mc-addi-btn--secondary" href="{{ block.settings[b_link2] | default: '#' }}">
                                {{ block.settings[b_button2] }}
                              </a>
                            {% endif %}
                          </div>
                        </div>
                      </figure>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {%- comment -%} SVG Sprite for stars {%- endcomment -%}
  <svg xmlns="http://www.w3.org/2000/svg" style="display:none">
    <symbol id="mc-star-empty" viewBox="0 0 16 16">
      <path d="M8 1l1.854 3.754 4.146.603-3 2.923.708 4.12L8 10.25l-3.708 1.95.708-4.12-3-2.923 4.146-.603z" fill="none" stroke="#d8d8d8" stroke-width="1"/>
    </symbol>
    <symbol id="mc-star-filled" viewBox="0 0 16 16">
      <path d="M8 1l1.854 3.754 4.146.603-3 2.923.708 4.12L8 10.25l-3.708 1.95.708-4.12-3-2.923 4.146-.603z" fill="currentColor"/>
    </symbol>
  </svg>

  <style>
    /* =============================================
       SECTION WRAPPER
    ============================================= */
    #{{ section_id }} {
      background: {{ section.settings.bg_color }};
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      color: {{ section.settings.text_color }};
    }

    #{{ section_id }} .mc-tabs__container {
      max-width: var(--page-width, 1400px);
      margin-left: auto;
      margin-right: auto;
      padding-left: var(--page-margin, 20px);
      padding-right: var(--page-margin, 20px);
    }

    /* =============================================
       HEADING
    ============================================= */
    #{{ section_id }} .mc-tabs__header {
      margin-bottom: 30px;
    }

    #{{ section_id }} .mc-tabs__title {
      margin: 0;
      font-size: clamp(34px, 5vw, 66px);
      line-height: 0.98;
      font-weight: 600;
      letter-spacing: -0.04em;
      max-width: 760px;
      white-space: pre-line;
      color: {{ section.settings.text_color }};
    }

    /* =============================================
       TAB NAV
    ============================================= */
    #{{ section_id }} .mc-tabs__nav-wrap {
      margin-bottom: 50px;
    }

    #{{ section_id }} .mc-tabs__nav {
      display: flex;
      gap: 0;
      flex-wrap: wrap;
      list-style: none;
      margin: 0;
      padding: 0;
      gap: {{ section.settings.tab_gap }}px;
    }

    #{{ section_id }} .mc-tabs__tab-item {
      display: inline-flex;
    }

    #{{ section_id }} .mc-tabs__tab {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      appearance: none;
      border: {{ section.settings.tab_border | default: '0' }}px solid {{ section.settings.tab_border_color | default: 'transparent' }};
      background: {{ section.settings.tab_bg }};
      color: {{ section.settings.tab_text }};
      border-radius: {{ section.settings.tab_radius }}px;
      padding: 0 18px;
      height: {{ section.settings.tab_height | default: 42 }}px;
      font-size: {{ section.settings.tab_font_size | default: 14 }}px;
      line-height: 1;
      font-weight: {{ section.settings.tab_font_weight | default: 500 }};
      letter-spacing: 0;
      cursor: pointer;
      transition: background .25s ease, color .25s ease;
      text-decoration: none;
    }

    #{{ section_id }} .mc-tabs__tab.is-active,
    #{{ section_id }} .mc-tabs__tab:hover {
      background: {{ section.settings.tab_active_bg }};
      color: {{ section.settings.tab_active_text }};
    }

    /* =============================================
       TAB PANELS
    ============================================= */
    #{{ section_id }} .mc-tabs__panel {
      display: none;
    }

    #{{ section_id }} .mc-tabs__panel.is-active {
      display: block;
    }

    /* =============================================
       VIEW ALL BUTTON
    ============================================= */
    #{{ section_id }} .mc-tabs__viewall-wrap {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 18px;
    }

    #{{ section_id }} .mc-tabs__viewall-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: {{ section.settings.text_color }};
      font-size: 16px;
      font-weight: 500;
      border: 1px solid {{ section.settings.text_color }};
      border-radius: 999px;
      padding: 0 20px;
      height: 40px;
      transition: background .2s, color .2s;
    }

    #{{ section_id }} .mc-tabs__viewall-btn:hover {
      background: {{ section.settings.text_color }};
      color: {{ section.settings.bg_color }};
    }

    #{{ section_id }} .mc-tabs__viewall-icon {
      width: 14px;
      height: 10px;
      flex-shrink: 0;
    }

    /* =============================================
       PRODUCTS GRID
    ============================================= */
    #{{ section_id }} .mc-products-wrap {
      overflow: visible;
      margin-bottom: 15px;
    }

    #{{ section_id }} .mc-products {
      display: grid;
      gap: 15px;
    }

    #{{ section_id }} .mc-products.t4s-row-cols-lg-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    #{{ section_id }} .mc-products.t4s-row-cols-lg-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #{{ section_id }} .mc-products.t4s-row-cols-lg-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #{{ section_id }} .mc-products.t4s-row-cols-lg-5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }

    /* =============================================
       PRODUCT CARD
    ============================================= */
    #{{ section_id }} .mc-product {
      min-width: 0;
    }

    #{{ section_id }} .mc-product__wrapper {
      position: relative;
      height: 100%;
      display: flex;
      flex-direction: column;
    }

    #{{ section_id }} .mc-product__inner {
      flex: 1;
      display: flex;
      flex-direction: column;
      position: relative;
      overflow: hidden;
    }

    /* Series label */
    #{{ section_id }} .mc-product__series {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: {{ section.settings.muted_text | default: '#666' }};
      text-align: center;
      margin-bottom: 4px;
      line-height: 1;
    }

    /* Title */
    #{{ section_id }} .mc-product__title {
      margin: 0 0 4px;
      text-align: center;
      font-size: 16px;
      line-height: 1.2;
      font-weight: 400;
      letter-spacing: -0.02em;
    }

    #{{ section_id }} .mc-product__title a {
      color: inherit;
      text-decoration: none;
    }

    #{{ section_id }} .mc-product__title a:hover {
      text-decoration: underline;
    }

    /* Rating */
    #{{ section_id }} .mc-product__rating {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      margin-bottom: 6px;
    }

    #{{ section_id }} .mc-product__stars {
      position: relative;
      display: inline-flex;
      font-size: 16px;
      line-height: 1;
    }

    #{{ section_id }} .mc-product__stars-bg,
    #{{ section_id }} .mc-product__stars-fill {
      display: block;
      color: #d8d8d8;
    }

    #{{ section_id }} .mc-product__stars-fill {
      color: {{ section.settings.star_color }};
      position: absolute;
      top: 0;
      left: 0;
      overflow: hidden;
      white-space: nowrap;
    }

    #{{ section_id }} .mc-product__reviews {
      font-size: 13px;
      color: #555;
      line-height: 1;
    }

    /* Image wrap */
    #{{ section_id }} .mc-product__image-wrap {
      margin-bottom: 0;
    }

    #{{ section_id }} .mc-product__image-ratio {
      position: relative;
      aspect-ratio: 0.8012;
      overflow: hidden;
      background: transparent;
    }

    #{{ section_id }} .mc-product__image-link {
      display: block;
      width: 100%;
      height: 100%;
    }

    #{{ section_id }} .mc-product__img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center center;
      transition: opacity .28s ease, transform .35s ease;
    }

    #{{ section_id }} .mc-product__img--main {
      opacity: 1;
      z-index: 1;
    }

    #{{ section_id }} .mc-product__img--hover {
      opacity: 0;
      z-index: 2;
    }

    #{{ section_id }} .mc-product__image-ratio:hover .mc-product__img--main {
      opacity: 0;
    }

    #{{ section_id }} .mc-product__image-ratio:hover .mc-product__img--hover {
      opacity: 1;
    }

    #{{ section_id }} .mc-product__image-ratio:hover .mc-product__img {
      transform: scale(1.02);
    }

    /* Badge */
    #{{ section_id }} .mc-product__badge-wrap {
      position: absolute;
      top: 10px;
      left: 10px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      z-index: 3;
    }

    #{{ section_id }} .mc-product__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 700;
      line-height: 1;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    #{{ section_id }} .mc-product__badge--custom {
      background: {{ section.settings.badge_bg }};
      color: {{ section.settings.badge_text }};
    }

    #{{ section_id }} .mc-product__badge--sale {
      background: #ffffff;
      color: {{ section.settings.text_color }};
      border: 1px solid {{ section.settings.text_color }};
    }

    /* Special Promotion (benefits) */
    #{{ section_id }} .mc-product__promotion {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      padding: 10px 8px 0;
    }

    #{{ section_id }} .mc-promotion-tag {
      display: inline-flex;
      align-items: center;
      padding: 0 10px;
      height: 26px;
      background: #f2f2f2;
      color: #000;
