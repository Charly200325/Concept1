<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>

{%- liquid
  assign section_rendering_api = false
  if section.index == nil
    assign section_rendering_api = true
  endif
-%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fc-tabs2">
        <div class="fc-tabs2__toolbar">
          <div class="fc-tabs2__nav scroll-area">
            <div class="fc-tabs2__nav-inner" role="tablist">
              {%- for block in section.blocks -%}
                {%- assign collection = block.settings.collection -%}
                <button
                  class="fc-tabs2__tab button{% if forloop.first %} button--primary{% else %} button--secondary{% endif %} whitespace-nowrap"
                  type="button"
                  data-tab-target="TabPanel-{{ block.id }}"
                  data-index="{{ forloop.index0 }}"
                  role="tab"
                  aria-controls="TabPanel-{{ block.id }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  {% if forloop.first %}disabled{% endif %}
                  {{ block.shopify_attributes }}
                >
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">
                    {%- liquid
                      if block.settings.title != blank or collection != blank
                        echo block.settings.title | default: collection.title | escape
                      else
                        echo 'Collection' | escape
                      endif
                    -%}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>

          {%- if section.settings.carousel_on_desktop -%}
            <div class="fc-tabs2__arrows hidden md:flex gap-2d5">
              {%- for block in section.blocks -%}
                <div
                  class="fc-tabs2__arrows-group flex gap-2d5"
                  data-arrows-for="TabPanel-{{ block.id }}"
                  {% unless forloop.first %}hidden{% endunless %}
                >
                  <button
                    class="button button--secondary"
                    type="button"
                    data-prev="Slider-{{ block.id }}"
                    aria-label="{{ 'general.pagination.previous' | t | escape }}"
                    disabled
                  >
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
                    </span>
                  </button>

                  <button
                    class="button button--secondary"
                    type="button"
                    data-next="Slider-{{ block.id }}"
                    aria-label="{{ 'general.pagination.next' | t | escape }}"
                  >
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
                    </span>
                  </button>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        {%- for block in section.blocks -%}
          {%- liquid
            assign collection = block.settings.collection
            assign products = block.settings.products | default: collection.products
          -%}

          <div
            id="TabPanel-{{ block.id }}"
            class="fc-tabs2__panel"
            role="tabpanel"
            {% unless forloop.first %}hidden{% endunless %}
          >
            <div
              id="Slider-{{ block.id }}"
              class="fc-tabs2__slider grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}"
              data-slider
            >
              <motion-list class="product-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
                {%- for product in products limit: section.settings.product_limit -%}
                  {%- render 'product-card',
                    product: product,
                    product_id: product.id,
                    section_id: section.id,
                    block_id: block.id,
                    lazy_load: false,
                    image_ratio: settings.product_image_ratio,
                    image_fill: settings.product_image_fill,
                    show_secondary_image: settings.product_secondary_image,
                    show_vendor: settings.product_vendor,
                    show_rating: settings.product_rating,
                    show_color_swatches: settings.product_color_swatches,
                    show_countdown: settings.product_countdown,
                    show_quick_add: settings.product_quick_add,
                    show_quick_view: settings.product_quick_view,
                    show_save_amount: settings.product_save_amount,
                    save_type: settings.product_save_type,
                    show_icon_list: settings.product_icon_list
                  -%}
                {%- else -%}
                  {%- for i in (1..section.settings.product_limit) -%}
                    {%- capture placeholder -%}product-{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
                    {%- render 'product-card-placeholder',
                      lazy_load: false,
                      image_ratio: settings.product_image_ratio,
                      image_fill: settings.product_image_fill,
                      show_secondary_image: settings.product_secondary_image,
                      show_vendor: settings.product_vendor,
                      show_rating: settings.product_rating,
                      show_color_swatches: settings.product_color_swatches,
                      show_countdown: settings.product_countdown,
                      show_quick_add: settings.product_quick_add,
                      show_quick_view: settings.product_quick_view,
                      show_save_amount: settings.product_save_amount,
                      save_type: settings.product_save_type,
                      placeholder: placeholder
                    -%}
                  {%- endfor -%}
                {%- endfor -%}
              </motion-list>
            </div>

            {%- if section.settings.show_view_all and collection != blank and section.settings.product_limit < collection.all_products_count -%}
              <p class="text-center fc-tabs2__view-all">
                <a
                  class="button button--secondary icon-with-text"
                  href="{{ collection.url }}"
                  is="hover-link"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}"
                >
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">
                    {%- liquid
                      render 'icon', icon: 'newspaper'
                      echo 'sections.featured_collection.view_all' | t
                    -%}
                  </span>
                </a>
              </p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var tabs = section.querySelectorAll('.fc-tabs2__tab');
    var panels = section.querySelectorAll('.fc-tabs2__panel');
    var arrowGroups = section.querySelectorAll('.fc-tabs2__arrows-group');

    function updateArrows(panelId) {
      var panel = section.querySelector('#' + panelId);
      if (!panel) return;

      var slider = panel.querySelector('[data-slider]');
      if (!slider) return;

      var prev = section.querySelector('[data-arrows-for="' + panelId + '"] [data-prev]');
      var next = section.querySelector('[data-arrows-for="' + panelId + '"] [data-next]');
      if (!prev || !next) return;

      var maxScroll = slider.scrollWidth - slider.clientWidth;
      var current = slider.scrollLeft;

      prev.disabled = current <= 4;
      next.disabled = current >= maxScroll - 4 || maxScroll <= 4;
    }

    function activateTab(targetId) {
      tabs.forEach(function (tab) {
        var active = tab.getAttribute('data-tab-target') === targetId;
        tab.setAttribute('aria-selected', active ? 'true' : 'false');
        tab.disabled = active;
        tab.classList.toggle('button--primary', active);
        tab.classList.toggle('button--secondary', !active);
      });

      panels.forEach(function (panel) {
        if (panel.id === targetId) {
          panel.removeAttribute('hidden');
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      arrowGroups.forEach(function (group) {
        if (group.getAttribute('data-arrows-for') === targetId) {
          group.removeAttribute('hidden');
        } else {
          group.setAttribute('hidden', '');
        }
      });

      setTimeout(function () {
        updateArrows(targetId);
      }, 60);
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        activateTab(this.getAttribute('data-tab-target'));
      });
    });

    section.querySelectorAll('[data-prev]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var sliderId = this.getAttribute('data-prev');
        var slider = section.querySelector('#' + sliderId);
        if (!slider) return;

        slider.scrollBy({
          left: -Math.min(slider.clientWidth * 0.85, 420),
          behavior: 'smooth'
        });

        var panel = this.closest('.fc-tabs2__arrows-group').getAttribute('data-arrows-for');
        setTimeout(function () {
          updateArrows(panel);
        }, 350);
      });
    });

    section.querySelectorAll('[data-next]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var sliderId = this.getAttribute('data-next');
        var slider = section.querySelector('#' + sliderId);
        if (!slider) return;

        slider.scrollBy({
          left: Math.min(slider.clientWidth * 0.85, 420),
          behavior: 'smooth'
        });

        var panel = this.closest('.fc-tabs2__arrows-group').getAttribute('data-arrows-for');
        setTimeout(function () {
          updateArrows(panel);
        }, 350);
      });
    });

    section.querySelectorAll('[data-slider]').forEach(function (slider) {
      slider.addEventListener('scroll', function () {
        var panel = slider.closest('.fc-tabs2__panel');
        if (panel && !panel.hasAttribute('hidden')) {
          updateArrows(panel.id);
        }
      });
    });

    window.addEventListener('resize', function () {
      var activePanel = section.querySelector('.fc-tabs2__panel:not([hidden])');
      if (activePanel) updateArrows(activePanel.id);
    });

    var firstPanel = section.querySelector('.fc-tabs2__panel');
    if (firstPanel) activateTab(firstPanel.id);
  });
</script>

<style>
  #shopify-section-{{ section.id }} .fc-tabs2__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    margin-bottom: 1.6rem;
  }

  #shopify-section-{{ section.id }} .fc-tabs2__nav {
    flex: 1 1 auto;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .fc-tabs2__nav-inner {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .fc-tabs2__view-all {
    margin-top: 2rem;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .fc-tabs2__toolbar {
      display: block;
    }

    #shopify-section-{{ section.id }} .fc-tabs2__nav-inner {
      flex-wrap: nowrap;
    }

    #shopify-section-{{ section.id }} .fc-tabs2__arrows {
      display: none !important;
    }
  }
</style>

