{% assign section_id = 'tabs-collections-' | append: section.id %}

<section id="{{ section_id }}" class="tabs-collections-custom">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign tab_blocks = section.blocks | where: "type", "tab" %}

    {% if tab_blocks.size > 0 %}
      <div class="tabs-nav">
        {% for block in tab_blocks %}
          <button
            class="tab-button{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-tab-target="tab-{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {{ block.settings.tab_title }}
          </button>
        {% endfor %}
      </div>

      <div class="tabs-content">
        {% for block in tab_blocks %}
          {% assign collection = collections[block.settings.collection] %}
          <div
            id="tab-{{ block.id }}"
            class="tab-panel{% if forloop.first %} is-active{% endif %}"
            {{ block.shopify_attributes }}
          >
            {% if collection != blank %}
              <div class="tab-top">
                {% if block.settings.view_all_text != blank %}
                  <a class="view-all-btn" href="{{ collection.url }}">
                    {{ block.settings.view_all_text }}
                  </a>
                {% endif %}
              </div>

              <div class="products-grid columns-{{ block.settings.products_per_row }}">
                {% for product in collection.products limit: block.settings.products_limit %}
                  <div class="product-card">
                    <a class="product-image-wrap" href="{{ product.url }}">
                      {% if product.featured_image %}
                        {{
                          product.featured_image
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            widths: '240,360,480,720,800',
                            class: 'product-image',
                            alt: product.featured_image.alt | escape
                        }}
                      {% endif %}

                      {% if product.compare_at_price > product.price %}
                        <span class="badge badge-sale">
                          -
                          {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%
                        </span>
                      {% endif %}
                    </a>

                    <div class="product-card__content">
                      {% if product.metafields.custom.series_title != blank %}
                        <div class="series-title">
                          {{ product.metafields.custom.series_title }}
                        </div>
                      {% endif %}

                      <h3 class="product-title">
                        <a href="{{ product.url }}">{{ product.title }}</a>
                      </h3>

                      <div class="product-price">
                        {% if product.compare_at_price > product.price %}
                          <span class="price price--sale">{{ product.price | money }}</span>
                          <span class="price price--compare">{{ product.compare_at_price | money }}</span>
                        {% else %}
                          <span class="price">{{ product.price | money }}</span>
                        {% endif %}
                      </div>

                      {% if product.metafields.custom.promo_tags != blank %}
                        {% assign promo_tags = product.metafields.custom.promo_tags.value %}
                        <div class="promo-tags">
                          {% for tag in promo_tags %}
                            <span>{{ tag }}</span>
                          {% endfor %}
                        </div>
                      {% endif %}

                      <div class="product-actions">
                        {% if product.metafields.custom.learn_more_link != blank %}
                          <a class="btn btn-secondary" href="{{ product.metafields.custom.learn_more_link }}">
                            Learn More
                          </a>
                        {% endif %}

                        <a class="btn btn-primary" href="{{ product.url }}">
                          Shop Now
                        </a>
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>

              {% if block.settings.banner_1_image != blank or block.settings.banner_2_image != blank %}
                <div class="promo-banners">
                  {% if block.settings.banner_1_image != blank %}
                    <div class="promo-banner">
                      <a href="{{ block.settings.banner_1_link | default: '#' }}">
                        {{
                          block.settings.banner_1_image
                          | image_url: width: 1200
                          | image_tag:
                            loading: 'lazy',
                            widths: '360,550,720,960,1200',
                            class: 'promo-banner__image',
                            alt: block.settings.banner_1_heading | escape
                        }}
                      </a>
                      <div class="promo-banner__content">
                        {% if block.settings.banner_1_heading != blank %}
                          <h3>{{ block.settings.banner_1_heading }}</h3>
                        {% endif %}
                        {% if block.settings.banner_1_text != blank %}
                          <p>{{ block.settings.banner_1_text }}</p>
                        {% endif %}
                        {% if block.settings.banner_1_button != blank %}
                          <a class="btn btn-primary" href="{{ block.settings.banner_1_link | default: '#' }}">
                            {{ block.settings.banner_1_button }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}

                  {% if block.settings.banner_2_image != blank %}
                    <div class="promo-banner">
                      <a href="{{ block.settings.banner_2_link | default: '#' }}">
                        {{
                          block.settings.banner_2_image
                          | image_url: width: 1200
                          | image_tag:
                            loading: 'lazy',
                            widths: '360,550,720,960,1200',
                            class: 'promo-banner__image',
                            alt: block.settings.banner_2_heading | escape
                        }}
                      </a>
                      <div class="promo-banner__content">
                        {% if block.settings.banner_2_heading != blank %}
                          <h3>{{ block.settings.banner_2_heading }}</h3>
                        {% endif %}
                        {% if block.settings.banner_2_text != blank %}
                          <p>{{ block.settings.banner_2_text }}</p>
                        {% endif %}
                        {% if block.settings.banner_2_button != blank %}
                          <a class="btn btn-primary" href="{{ block.settings.banner_2_link | default: '#' }}">
                            {{ block.settings.banner_2_button }}
                          </a>
                        {% endif %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
            {% else %}
              <p>Collection non trouvée pour cet onglet.</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    .tabs-collections-custom {
      padding: 60px 0;
    }

    .tabs-collections-custom .section-header {
      text-align: center;
      margin-bottom: 30px;
    }

    .tabs-collections-custom .section-header h2 {
      margin: 0;
      font-size: 36px;
      line-height: 1.2;
    }

    .tabs-nav {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 30px;
    }

    .tab-button {
      border: 1px solid #ddd;
      background: #fff;
      padding: 10px 18px;
      cursor: pointer;
      border-radius: 999px;
      transition: 0.2s ease;
    }

    .tab-button.is-active {
      background: #9c5455;
      color: #fff;
      border-color: #9c5455;
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.is-active {
      display: block;
    }

    .tab-top {
      text-align: center;
      margin-bottom: 24px;
    }

    .view-all-btn {
      display: inline-block;
      padding: 10px 18px;
      border: 1px solid #111;
      text-decoration: none;
      color: #111;
      border-radius: 999px;
    }

    .products-grid {
      display: grid;
      gap: 20px;
      margin-bottom: 30px;
    }

    .products-grid.columns-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .products-grid.columns-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .products-grid.columns-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .product-card {
      border: 1px solid #eee;
      padding: 16px;
      position: relative;
      height: 100%;
    }

    .product-image-wrap {
      display: block;
      position: relative;
      margin-bottom: 14px;
    }

    .product-image {
      width: 100%;
      height: auto;
      display: block;
    }

    .badge {
      position: absolute;
      top: 10px;
      left: 10px;
      background: #111;
      color: #fff;
      padding: 4px 8px;
      font-size: 12px;
      border-radius: 4px;
    }

    .series-title {
      font-size: 13px;
      opacity: 0.7;
      margin-bottom: 6px;
    }

    .product-title {
      margin: 0 0 10px;
      font-size: 18px;
      line-height: 1.35;
    }

    .product-title a {
      color: inherit;
      text-decoration: none;
    }

    .product-price {
      margin-bottom: 10px;
    }

    .price--compare {
      margin-left: 8px;
      text-decoration: line-through;
      opacity: 0.6;
    }

    .promo-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 14px;
    }

    .promo-tags span {
      font-size: 12px;
      padding: 6px 10px;
      background: #f5f5f5;
      border-radius: 999px;
    }

    .product-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 10px 16px;
      text-decoration: none;
      border-radius: 999px;
      font-size: 14px;
    }

    .btn-primary {
      background: #111;
      color: #fff;
    }

    .btn-secondary {
      background: transparent;
      color: #111;
      border: 1px solid #111;
    }

    .promo-banners {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .promo-banner {
      position: relative;
      overflow: hidden;
      border-radius: 12px;
      background: #f7f7f7;
    }

    .promo-banner__image {
      width: 100%;
      height: auto;
      display: block;
    }

    .promo-banner__content {
      padding: 20px;
    }

    .promo-banner__content h3 {
      margin-top: 0;
      margin-bottom: 10px;
    }

    .promo-banner__content p {
      margin-bottom: 14px;
    }

    @media screen and (max-width: 989px) {
      .products-grid.columns-4,
      .products-grid.columns-3 {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .promo-banners {
        grid-template-columns: 1fr;
      }
    }

    @media screen and (max-width: 749px) {
      .tabs-collections-custom {
        padding: 40px 0;
      }

      .tabs-collections-custom .section-header h2 {
        font-size: 28px;
      }

      .products-grid.columns-4,
      .products-grid.columns-3,
      .products-grid.columns-2 {
        grid-template-columns: 1fr 1fr;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const section = document.getElementById('{{ section_id }}');
      if (!section) return;

      const buttons = section.querySelectorAll('.tab-button');
      const panels = section.querySelectorAll('.tab-panel');

      buttons.forEach((button) => {
        button.addEventListener('click', function () {
          const target = this.getAttribute('data-tab-target');

          buttons.forEach((btn) => btn.classList.remove('is-active'));
          panels.forEach((panel) => panel.classList.remove('is-active'));

          this.classList.add('is-active');
          const activePanel = section.querySelector('#' + target);
          if (activePanel) activePanel.classList.add('is-active');
        });
      });
    });
  </script>
</section>

{% schema %}
{
  "name": "Tabs collections custom",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Titre",
      "default": "Maximizing Comfort\nfor Moms at Every Step."
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Onglet",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Titre de l'onglet",
          "default": "Breast Pumps"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "view_all_text",
          "label": "Texte bouton voir tout",
          "default": "View all"
        },
        {
          "type": "range",
          "id": "products_limit",
          "label": "Nombre de produits",
          "min": 2,
          "max": 12,
          "step": 1,
          "default": 4
        },
        {
          "type": "select",
          "id": "products_per_row",
          "label": "Produits par ligne desktop",
          "default": "4",
          "options": [
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" },
            { "value": "4", "label": "4" }
          ]
        },
        {
          "type": "image_picker",
          "id": "banner_1_image",
          "label": "Bannière 1 image"
        },
        {
          "type": "text",
          "id": "banner_1_heading",
          "label": "Bannière 1 titre"
        },
        {
          "type": "textarea",
          "id": "banner_1_text",
          "label": "Bannière 1 texte"
        },
        {
          "type": "text",
          "id": "banner_1_button",
          "label": "Bannière 1 bouton"
        },
        {
          "type": "url",
          "id": "banner_1_link",
          "label": "Bannière 1 lien"
        },
        {
          "type": "image_picker",
          "id": "banner_2_image",
          "label": "Bannière 2 image"
        },
        {
          "type": "text",
          "id": "banner_2_heading",
          "label": "Bannière 2 titre"
        },
        {
          "type": "textarea",
          "id": "banner_2_text",
          "label": "Bannière 2 texte"
        },
        {
          "type": "text",
          "id": "banner_2_button",
          "label": "Bannière 2 bouton"
        },
        {
          "type": "url",
          "id": "banner_2_link",
          "label": "Bannière 2 lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Tabs collections custom",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}