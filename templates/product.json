cument.querySelectorAll('.video-social-card-template--21503048089929__video_from_social_3_A4kYJf').forEach(el => {\n      const btn = el.querySelector('.video-social-action-template--21503048089929__video_from_social_3_A4kYJf');\n      const video = el.querySelector('video');\n      const frame = el.querySelector('iframe');\n\n      if (!btn || (!video && !frame)) return;\n\n      btn.addEventListener('click', () => {\n        const isActive = btn.classList.toggle('active');\n\n        // Stop toutes les autres vidéos avant d’en lancer une\n        document.querySelectorAll('.video-social-card-template--21503048089929__video_from_social_3_A4kYJf video').forEach(v => {\n          if (v !== video) {\n            v.pause();\n            v.currentTime = 0;\n          }\n        });\n        document.querySelectorAll('.video-social-action-template--21503048089929__video_from_social_3_A4kYJf').forEach(b => {\n          if (b !== btn) b.classList.remove('active');\n        });\n\n        if (video) {\n          if (isActive) {\n            video.play();\n            video.muted = false;\n          } else {\n            video.pause();\n          }\n        }\n      });\n    });\n\n    // Stop les vidéos quand elles sortent du champ de vision\n    const observer = new IntersectionObserver(entries => {\n      entries.forEach(entry => {\n        const video = entry.target.querySelector('video');\n        const btn = entry.target.querySelector('.video-social-action-template--21503048089929__video_from_social_3_A4kYJf');\n        if (!entry.isIntersecting && video && !video.paused) {\n          video.pause();\n          btn?.classList.remove('active');\n        }\n      });\n    }, { threshold: 0.2 });\n\n    document.querySelectorAll('.video-social-card-template--21503048089929__video_from_social_3_A4kYJf').forEach(card => {\n      observer.observe(card);\n    });\n  }\n\n  document.addEventListener('DOMContentLoaded', initVideoFromSocial3);\n  if (Shopify.designMode) {\n    document.addEventListener('shopify:section:unload', initVideoFromSocial3);\n    document.addEventListener('shopify:section:load', initVideoFromSocial3);\n  }\n</script>\n\n</div>",
