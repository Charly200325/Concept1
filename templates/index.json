        "custom_HTML": "<style>\n  .hero-slideshow-premium {\n    position: relative;\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n    background: #f5f3f0;\n  }\n\n  .hero-slideshow-premium__container {\n    position: relative;\n    width: 100%;\n    padding-bottom: 45.5%; /* 1989:907 ratio */\n    overflow: hidden;\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__container {\n      padding-bottom: 140%; /* 400:560 ratio */\n    }\n  }\n\n  .hero-slideshow-premium__slide {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    transition: opacity 0.8s ease-in-out;\n  }\n\n  .hero-slideshow-premium__slide.active {\n    opacity: 1;\n  }\n\n  .hero-slideshow-premium__image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n\n  .hero-slideshow-premium__content {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n    padding: 60px 80px;\n    color: #fff;\n    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__content {\n      padding: 40px 30px;\n      justify-content: flex-end;\n    }\n  }\n\n  .hero-slideshow-premium__title {\n    font-size: 56px;\n    font-weight: 700;\n    line-height: 1.2;\n    margin: 0 0 20px 0;\n    letter-spacing: -1px;\n    animation: slideInUp 0.8s ease-out 0.2s both;\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__title {\n      font-size: 32px;\n    }\n  }\n\n  .hero-slideshow-premium__subtitle {\n    font-size: 20px;\n    font-weight: 400;\n    margin: 0 0 15px 0;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    opacity: 0.9;\n    animation: slideInUp 0.8s ease-out 0.4s both;\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__subtitle {\n      font-size: 14px;\n    }\n  }\n\n  .hero-slideshow-premium__text {\n    font-size: 16px;\n    line-height: 1.6;\n    margin: 0 0 30px 0;\n    max-width: 500px;\n    opacity: 0.95;\n    animation: slideInUp 0.8s ease-out 0.6s both;\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__text {\n      font-size: 14px;\n      margin: 0 0 20px 0;\n    }\n  }\n\n  .hero-slideshow-premium__button {\n    display: inline-block;\n    padding: 14px 40px;\n    background: #fff;\n    color: #171717;\n    text-decoration: none;\n    font-weight: 600;\n    font-size: 14px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    border-radius: 50px;\n    transition: all 0.3s ease;\n    animation: slideInUp 0.8s ease-out 0.8s both;\n    border: 2px solid #fff;\n  }\n\n  .hero-slideshow-premium__button:hover {\n    background: transparent;\n    color: #fff;\n    transform: translateY(-2px);\n  }\n\n  @keyframes slideInUp {\n    from {\n      opacity: 0;\n      transform: translateY(30px);\n    }\n    to {\n      opacity: 1;\n      transform: translateY(0);\n    }\n  }\n\n  /* Navigation Bars */\n  .hero-slideshow-premium__nav {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    right: 0;\n    display: flex;\n    height: 4px;\n    background: rgba(255, 255, 255, 0.2);\n    z-index: 10;\n  }\n\n  .hero-slideshow-premium__nav-bar {\n    flex: 1;\n    background: rgba(255, 255, 255, 0.3);\n    cursor: pointer;\n    position: relative;\n    transition: background 0.3s ease;\n    border-right: 1px solid rgba(0, 0, 0, 0.1);\n  }\n\n  .hero-slideshow-premium__nav-bar:last-child {\n    border-right: none;\n  }\n\n  .hero-slideshow-premium__nav-bar.active {\n    background: #fff;\n  }\n\n  .hero-slideshow-premium__nav-bar:hover {\n    background: rgba(255, 255, 255, 0.6);\n  }\n\n  .hero-slideshow-premium__nav-label {\n    position: absolute;\n    bottom: 12px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-size: 12px;\n    color: #fff;\n    white-space: nowrap;\n    opacity: 0;\n    transition: opacity 0.3s ease;\n    pointer-events: none;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    font-weight: 600;\n  }\n\n  .hero-slideshow-premium__nav-bar:hover .hero-slideshow-premium__nav-label {\n    opacity: 1;\n  }\n\n  /* Play/Pause Button */\n  .hero-slideshow-premium__controls {\n    position: absolute;\n    bottom: 30px;\n    right: 30px;\n    z-index: 20;\n    display: flex;\n    align-items: center;\n    gap: 20px;\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__controls {\n      bottom: 20px;\n      right: 20px;\n    }\n  }\n\n  .hero-slideshow-premium__play-pause {\n    width: 60px;\n    height: 60px;\n    border-radius: 50%;\n    background: rgba(255, 255, 255, 0.15);\n    border: 2px solid rgba(255, 255, 255, 0.4);\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: all 0.3s ease;\n    position: relative;\n    backdrop-filter: blur(10px);\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__play-pause {\n      width: 50px;\n      height: 50px;\n    }\n  }\n\n  .hero-slideshow-premium__play-pause:hover {\n    background: rgba(255, 255, 255, 0.25);\n    border-color: rgba(255, 255, 255, 0.6);\n  }\n\n  .hero-slideshow-premium__play-pause svg {\n    width: 24px;\n    height: 24px;\n    fill: #fff;\n    transition: transform 0.3s ease;\n  }\n\n  @media (max-width: 768px) {\n    .hero-slideshow-premium__play-pause svg {\n      width: 18px;\n      height: 18px;\n    }\n  }\n\n  .hero-slideshow-premium__progress-circle {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100%;\n    border-radius: 50%;\n  }\n\n  .hero-slideshow-premium__progress-circle circle {\n    fill: none;\n    stroke: rgba(255, 255, 255, 0.3);\n    stroke-width: 2;\n  }\n\n  .hero-slideshow-premium__progress-circle .progress {\n    fill: none;\n    stroke: #fff;\n    stroke-width: 2;\n    stroke-linecap: round;\n    transition: stroke-dashoffset 0.1s linear;\n  }\n\n  /* Slide Counter */\n  .hero-slideshow-premium__counter {\n    color: rgba(255, 255, 255, 0.7);\n    font-size: 12px;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    font-weight: 600;\n  }\n</style>\n\n<div class=\"hero-slideshow-premium\">\n  <div class=\"hero-slideshow-premium__container\">\n    <!-- Slide 1 -->\n    <div class=\"hero-slideshow-premium__slide active\">\n      <img src=\"https://images.unsplash.com/photo-1505142468610-359e7d316be0?w=2000&h=900&fit=crop\" alt=\"Slide 1\" class=\"hero-slideshow-premium__image\">\n      <div class=\"hero-slideshow-premium__content\">\n        <div class=\"hero-slideshow-premium__subtitle\">Nouvelle Collection</div>\n        <h1 class=\"hero-slideshow-premium__title\">Confort Premium</h1>\n        <p class=\"hero-slideshow-premium__text\">Découvrez notre nouvelle collection de produits haut de gamme, conçus pour votre bien-être et celui de votre famille.</p>\n        <a href=\"#\" class=\"hero-slideshow-premium__button\">Découvrir</a>\n      </div>\n    </div>\n\n    <!-- Slide 2 -->\n    <div class=\"hero-slideshow-premium__slide\">\n      <img src=\"https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=2000&h=900&fit=crop\" alt=\"Slide 2\" class=\"hero-slideshow-premium__image\">\n      <div class=\"hero-slideshow-premium__content\">\n        <div class=\"hero-slideshow-premium__subtitle\">Qualité Garantie</div>\n        <h1 class=\"hero-slideshow-premium__title\">Produits Durables</h1>\n        <p class=\"hero-slideshow-premium__text\">Tous nos produits sont fabriqués avec les meilleurs matériaux pour assurer durabilité et confort optimal.</p>\n        <a href=\"#\" class=\"hero-slideshow-premium__button\">En Savoir Plus</a>\n      </div>\n    </div>\n\n    <!-- Slide 3 -->\n    <div class=\"hero-slideshow-premium__slide\">\n      <img src=\"https://images.unsplash.com/photo-1492684223066-81342ee5ff30?w=2000&h=900&fit=crop\" alt=\"Slide 3\" class=\"hero-slideshow-premium__image\">\n      <div class=\"hero-slideshow-premium__content\">\n        <div class=\"hero-slideshow-premium__subtitle\">Satisfaction Client</div>\n        <h1 class=\"hero-slideshow-premium__title\">Confiance & Qualité</h1>\n        <p class=\"hero-slideshow-premium__text\">Rejoignez des milliers de clients satisfaits qui font confiance à nos produits pour leur quotidien.</p>\n        <a href=\"#\" class=\"hero-slideshow-premium__button\">Commencer</a>\n      </div>\n    </div>\n\n    <!-- Navigation Bars -->\n    <div class=\"hero-slideshow-premium__nav\">\n      <div class=\"hero-slideshow-premium__nav-bar active\" data-slide=\"0\">\n        <span class=\"hero-slideshow-premium__nav-label\">Confort</span>\n      </div>\n      <div class=\"hero-slideshow-premium__nav-bar\" data-slide=\"1\">\n        <span class=\"hero-slideshow-premium__nav-label\">Qualité</span>\n      </div>\n      <div class=\"hero-slideshow-premium__nav-bar\" data-slide=\"2\">\n        <span class=\"hero-slideshow-premium__nav-label\">Confiance</span>\n      </div>\n    </div>\n\n    <!-- Controls -->\n    <div class=\"hero-slideshow-premium__controls\">\n      <div class=\"hero-slideshow-premium__counter\">\n        <span class=\"current\">01</span> / <span class=\"total\">03</span>\n      </div>\n      <button class=\"hero-slideshow-premium__play-pause\" aria-label=\"Play/Pause\">\n        <svg class=\"play-icon\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <polygon points=\"5 3 19 12 5 21\"></polygon>\n        </svg>\n        <svg class=\"pause-icon\" style=\"display: none;\" viewbox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\">\n          <rect x=\"6\" y=\"4\" width=\"4\" height=\"16\"></rect>\n          <rect x=\"14\" y=\"4\" width=\"4\" height=\"16\"></rect>\n        </svg>\n        <svg class=\"hero-slideshow-premium__progress-circle\" viewbox=\"0 0 60 60\">\n          <circle cx=\"30\" cy=\"30\" r=\"28\"></circle>\n          <circle class=\"progress\" cx=\"30\" cy=\"30\" r=\"28\" style=\"stroke-dasharray: 175.93; stroke-dashoffset: 175.93;\"></circle>\n        </svg>\n      </button>\n    </div>\n  </div>\n</div>\n\n<script>\n  (function() {\n    const slideshow = document.querySelector('.hero-slideshow-premium');\n    if (!slideshow) return;\n\n    const slides = slideshow.querySelectorAll('.hero-slideshow-premium__slide');\n    const navBars = slideshow.querySelectorAll('.hero-slideshow-premium__nav-bar');\n    const playPauseBtn = slideshow.querySelector('.hero-slideshow-premium__play-pause');\n    const playIcon = slideshow.querySelector('.play-icon');\n    const pauseIcon = slideshow.querySelector('.pause-icon');\n    const currentCounter = slideshow.querySelector('.current');\n    const progressCircle = slideshow.querySelector('.progress');\n\n    let currentSlide = 0;\n    let isPlaying = true;\n    let autoplayInterval;\n    const autoplayDuration = 5000; // 5 seconds\n    const slideDuration = 5000;\n\n    function updateSlide(index) {\n      slides.forEach((slide, i) => {\n        slide.classList.toggle('active', i === index);\n      });\n      navBars.forEach((bar, i) => {\n        bar.classList.toggle('active', i === index);\n      });\n      currentCounter.textContent = String(index + 1).padStart(2, '0');\n      resetProgress();\n    }\n\n    function nextSlide() {\n      currentSlide = (currentSlide + 1) % slides.length;\n      updateSlide(currentSlide);\n    }\n\n    function goToSlide(index) {\n      currentSlide = index;\n      updateSlide(currentSlide);\n      if (isPlaying) {\n        clearInterval(autoplayInterval);\n        startAutoplay();\n      }\n    }\n\n    function startAutoplay() {\n      autoplayInterval = setInterval(nextSlide, autoplayDuration);\n      animateProgress();\n    }\n\n    function stopAutoplay() {\n      clearInterval(autoplayInterval);\n    }\n\n    function togglePlayPause() {\n      isPlaying = !isPlaying;\n      playIcon.style.display = isPlaying ? 'none' : 'block';\n      pauseIcon.style.display = isPlaying ? 'block' : 'none';\n\n      if (isPlaying) {\n        startAutoplay();\n      } else {\n        stopAutoplay();\n      }\n    }\n\n    function resetProgress() {\n      const circumference = 2 * Math.PI * 28;\n      progressCircle.style.strokeDashoffset = circumference;\n    }\n\n    function animateProgress() {\n      const circumference = 2 * Math.PI * 28;\n      let elapsed = 0;\n      const step = 50; // Update every 50ms\n\n      const progressInterval = setInterval(() => {\n        elapsed += step;\n        const progress = (elapsed / slideDuration) * circumference;\n        progressCircle.style.strokeDashoffset = circumference - progress;\n\n        if (elapsed >= slideDuration) {\n          clearInterval(progressInterval);\n        }\n      }, step);\n    }\n\n    // Event listeners\n    playPauseBtn.addEventListener('click', togglePlayPause);\n\n    navBars.forEach((bar, index) => {\n      bar.addEventListener('click', () => goToSlide(index));\n    });\n\n    // Pause on hover\n    slideshow.addEventListener('mouseenter', () => {\n      if (isPlaying) {\n        stopAutoplay();\n      }\n    });\n\n    slideshow.addEventListener('mouseleave', () => {\n      if (isPlaying) {\n        startAutoplay();\n      }\n    });\n\n    // Initialize\n    pauseIcon.style.display = 'block';\n    playIcon.style.display = 'none';\n    startAutoplay();\n  })();\n</script>"
      }
    },
