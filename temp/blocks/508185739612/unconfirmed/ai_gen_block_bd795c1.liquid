{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.header_bg_color }};
    color: {{ block.settings.header_text_color }};
    padding: {{ block.settings.header_padding }}px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 4px rgba(0, 0, 0, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
  }

  .ai-header-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.container_padding }}px;
  }

  .ai-header-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: {{ block.settings.items_gap }}px;
  }

  .ai-header-menu-btn-{{ ai_gen_id }} {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.header_text_color }};
    line-height: 1;
  }

  .ai-header-menu-btn-{{ ai_gen_id }} svg {
    width: {{ block.settings.menu_icon_size }}px;
    height: auto;
    display: block;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    line-height: 1;
  }

  .ai-header-logo-{{ ai_gen_id }} a {
    display: inline-flex;
    text-decoration: none;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    display: block;
    width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-header-nav-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    justify-content: {{ block.settings.nav_alignment }};
  }

  .ai-header-nav-list-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.nav_items_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-nav-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-header-nav-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 0;
    color: {{ block.settings.header_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_font_size }}px;
    font-weight: {{ block.settings.nav_font_weight }};
    transition: color 0.3s ease;
  }

  .ai-header-nav-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.nav_hover_color }};
  }

  .ai-header-nav-link-{{ ai_gen_id }}.has-subtitle {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  .ai-header-nav-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.nav_font_size | times: 0.75 }}px;
    font-weight: 400;
    opacity: 0.8;
  }

  .ai-header-nav-arrow-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    transition: transform 0.3s ease;
  }

  .ai-header-nav-item-{{ ai_gen_id }}:hover .ai-header-nav-arrow-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-header-mobile-drawer-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: -100%;
    width: {{ block.settings.drawer_width }}px;
    max-width: 90%;
    height: 100vh;
    background-color: {{ block.settings.drawer_bg_color }};
    z-index: 2000;
    transition: left 0.3s ease;
    overflow-y: auto;
    padding: 20px;
  }

  .ai-header-mobile-drawer-{{ ai_gen_id }}.active {
    left: 0;
  }

  .ai-header-drawer-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-header-drawer-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-header-drawer-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    margin-bottom: 20px;
    color: {{ block.settings.drawer_text_color }};
    font-size: 24px;
    line-height: 1;
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} li {
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-header-drawer-nav-{{ ai_gen_id }} a {
    display: block;
    padding: 15px 0;
    color: {{ block.settings.drawer_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.nav_font_size }}px;
  }

  @media (max-width: 1024px) {
    .ai-header-menu-btn-{{ ai_gen_id }} {
      display: flex;
    }

    .ai-header-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-header-logo-{{ ai_gen_id }} img {
      width: {{ block.settings.logo_width_mobile }}px;
    }
  }
{% endstyle %}

<header-component-{{ ai_gen_id }} class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <div class="ai-header-row-{{ ai_gen_id }}">
      <button
        class="ai-header-menu-btn-{{ ai_gen_id }}"
        aria-label="Open menu"
        data-menu-toggle
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 16" fill="currentColor">
          <rect width="25" height="2"></rect>
          <rect y="7" width="25" height="2"></rect>
          <rect y="14" width="25" height="2"></rect>
        </svg>
      </button>

      <div class="ai-header-logo-{{ ai_gen_id }}">
        <a href="/">
          {% if block.settings.logo %}
            <img
              src="{{ block.settings.logo | image_url: width: 400 }}"
              alt="{{ shop.name }}"
              width="{{ block.settings.logo_width }}"
              height="auto"
              loading="eager"
            >
          {% else %}
            <div style="width: {{ block.settings.logo_width }}px; height: 40px; background: #f4f4f4; display: flex; align-items: center; justify-content: center; font-size: 12px; color: #999;">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </a>
      </div>

      <nav class="ai-header-nav-{{ ai_gen_id }}">
        <ul class="ai-header-nav-list-{{ ai_gen_id }}">
          {% for i in (1..5) %}
            {% liquid
              assign link_enabled_key = 'nav_link_' | append: i | append: '_enabled'
              assign link_text_key = 'nav_link_' | append: i | append: '_text'
              assign link_url_key = 'nav_link_' | append: i | append: '_url'
              assign link_subtitle_key = 'nav_link_' | append: i | append: '_subtitle'
              assign link_color_key = 'nav_link_' | append: i | append: '_color'

              assign link_enabled = block.settings[link_enabled_key]
              assign link_text = block.settings[link_text_key]
              assign link_url = block.settings[link_url_key]
              assign link_subtitle = block.settings[link_subtitle_key]
              assign link_color = block.settings[link_color_key]
            %}

            {% if link_enabled and link_text != blank %}
              <li class="ai-header-nav-item-{{ ai_gen_id }}">
                <a
                  href="{{ link_url }}"
                  class="ai-header-nav-link-{{ ai_gen_id }} {% if link_subtitle != blank %}has-subtitle{% endif %}"
                  {% if link_color != blank %}style="color: {{ link_color }};"{% endif %}
                >
                  <span>
                    {{ link_text }}
                    {% if link_subtitle != blank %}
                      <span class="ai-header-nav-subtitle-{{ ai_gen_id }}">{{ link_subtitle }}</span>
                    {% endif %}
                  </span>
                  {% if block.settings.show_nav_arrows %}
                    <svg class="ai-header-nav-arrow-{{ ai_gen_id }}" viewBox="0 0 19 12" fill="currentColor">
                      <path d="M9.5 12L0 2.5L2.5 0L9.5 7L16.5 0L19 2.5L9.5 12Z"/>
                    </svg>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    </div>
  </div>

  <div class="ai-header-drawer-overlay-{{ ai_gen_id }}" data-drawer-overlay></div>

  <div class="ai-header-mobile-drawer-{{ ai_gen_id }}" data-mobile-drawer>
    <button class="ai-header-drawer-close-{{ ai_gen_id }}" aria-label="Close menu" data-drawer-close>
      ×
    </button>

    <ul class="ai-header-drawer-nav-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign link_enabled_key = 'nav_link_' | append: i | append: '_enabled'
          assign link_text_key = 'nav_link_' | append: i | append: '_text'
          assign link_url_key = 'nav_link_' | append: i | append: '_url'

          assign link_enabled = block.settings[link_enabled_key]
          assign link_text = block.settings[link_text_key]
          assign link_url = block.settings[link_url_key]
        %}

        {% if link_enabled and link_text != blank %}
          <li>
            <a href="{{ link_url }}">{{ link_text }}</a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</header-component-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderComponent{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.menuToggle = this.querySelector('[data-menu-toggle]');
        this.drawerClose = this.querySelector('[data-drawer-close]');
        this.drawer = this.querySelector('[data-mobile-drawer]');
        this.overlay = this.querySelector('[data-drawer-overlay]');

        this.setupEventListeners();
      }

      setupEventListeners() {
        if (this.menuToggle) {
          this.menuToggle.addEventListener('click', () => this.openDrawer());
        }

        if (this.drawerClose) {
          this.drawerClose.addEventListener('click', () => this.closeDrawer());
        }

        if (this.overlay) {
          this.overlay.addEventListener('click', () => this.closeDrawer());
        }

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.drawer.classList.contains('active')) {
            this.closeDrawer();
          }
        });
      }

      openDrawer() {
        this.drawer.classList.add('active');
        this.overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      closeDrawer() {
        this.drawer.classList.remove('active');
        this.overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    customElements.define('header-component-{{ ai_gen_id }}', HeaderComponent{{ ai_gen_id }});
  })();
</script>

